  .ai-ava { width: 30px; height: 30px; border-radius: 50%; background: #ecfdf5; display: flex;
    align-items: center; justify-content: center; font-size: 15px; flex-shrink: 0; }
  .ai-bubble { background: #f1f5f9; border-radius: 14px; padding: .6rem .8rem; font-size: .85rem;
    line-height: 1.45; color: #1e293b; max-width: 46ch; }
  .ai-msg.user .ai-bubble { background: #2563eb; color: #fff; }
  .ai-bullet { padding-left: .9rem; position: relative; }
  .ai-bullet:before { content: '•'; position: absolute; left: .2rem; color: #64748b; font-weight: 900; }
  .ai-src, .ai-time { display: block; font-size: .6rem; color: #94a3b8; margin-top: .2rem; font-weight: 700; }
  .ai-msg.user .ai-time { text-align: right; }
  .ai-input-row { display: flex; gap: .5rem; margin-top: .75rem; }
  .ai-input-row .input { flex: 1 1 auto; }
  .ai-chip { display: block; width: 100%; text-align: left; font-size: .78rem; font-weight: 600;
    padding: .5rem .65rem; border-radius: 10px; background: #f8fafc; border: 1px solid #e2e8f0; color: #334155; }
  .ai-chip:hover { background: #eff6ff; border-color: #93c5fd; color: #1d4ed8; }
  .ai-typing { display: flex; align-items: center; gap: .3rem; font-size: .72rem; color: #94a3b8;
    font-weight: 700; margin: .4rem 0; }

              decoder: { readers: ['ean_reader', 'ean_8_reader', 'upc_reader', 'code_128_reader', 'code_39_reader'] } },
              function (r) { if (r && r.codeResult) self.send(r.codeResult.code); busy = false; });
          } else busy = false;
        }, 350);
      }).catch(function () { self.setPhone('No se pudo abrir la cámara. Usá el campo manual.', true); });
    },
    stopCam: function () {
      if (this.timer) { clearInterval(this.timer); this.timer = null; }
      if (this.stream) { try { this.stream.getTracks().forEach(function (t) { t.stop(); }); } catch (e) {} this.stream = null; }
    },
    setPhone: function (txt, bad) {
      var el = $('gsPhoneMsg'); if (!el) return;
      el.textContent = txt; el.style.color = bad ? '#fca5a5' : '#6ee7b7';
    },


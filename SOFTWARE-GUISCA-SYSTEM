}
.inv-drop:hover { border-color: #60a5fa; background: #eff6ff; }
.inv-drop.drag { border-color: #2563eb; background: #dbeafe; transform: scale(1.01); }
.inv-bar { width: 100%; height: 9px; border-radius: 999px; background: #e2e8f0; overflow: hidden; }
.inv-bar-fill {
  width: 0%; height: 100%; border-radius: 999px;
  background: linear-gradient(90deg, #3b82f6, #06b6d4);
  transition: width .25s ease;
}
.inv-opt {
  display: inline-flex; align-items: center; gap: .35rem; font-size: .72rem; font-weight: 700;
  color: #334155; cursor: pointer; user-select: none;
}
.inv-opt input { width: 14px; height: 14px; accent-color: #2563eb; cursor: pointer; }
.inv-chip {
  display: inline-flex; align-items: center; gap: .3rem; font-size: .68rem; font-weight: 800;
  padding: .25rem .55rem; border-radius: 999px; background: #f1f5f9; color: #475569;
  border: 1px solid #e2e8f0;
}
.inv-chip b { font-weight: 900; }
.inv-chip.green { background: #ecfdf5; color: #047857; border-color: #a7f3d0; }
.inv-chip.blue  { background: #eff6ff; color: #1d4ed8; border-color: #bfdbfe; }
.inv-chip.amber { background: #fffbeb; color: #b45309; border-color: #fde68a; }
.inv-chip.rose  { background: #fff1f2; color: #be123c; border-color: #fecdd3; }
.inv-sel {
  width: 100%; min-width: 8rem; max-width: 15rem; font-size: .72rem; font-weight: 700;
  padding: .3rem .45rem; border: 1px solid var(--border); border-radius: 9px; background: #fff; color: #0f172a;
}
.inv-num {
  width: 4.5rem; font-size: .75rem; font-weight: 800; text-align: right;
  padding: .3rem .4rem; border: 1px solid var(--border); border-radius: 9px; background: #fff;
  font-family: 'JetBrains Mono', ui-monospace, monospace;
}
.inv-tr { transition: background .15s ease; }
.inv-tr:hover { background: #f8fafc; }
.inv-tr.off { opacity: .5; }
.inv-desc { font-weight: 700; color: #0f172a; }
.inv-sub { font-size: .62rem; color: #94a3b8; font-weight: 600; }
.inv-delta { font-weight: 800; font-size: .72rem; }
.inv-delta.up { color: #047857; }
.inv-delta.same { color: #94a3b8; }
.inv-stock { font-family: 'JetBrains Mono', ui-monospace, monospace; font-weight: 800; font-size: .72rem; }
.inv-stock .arrow { color: #94a3b8; font-weight: 400; }
.inv-cat {
  width: 100%; min-width: 6.5rem; font-size: .72rem; font-weight: 700;
  padding: .3rem .45rem; border: 1px solid var(--border); border-radius: 9px;
  background: #fff; color: #0f172a;
}
.inv-cat:focus { outline: none; border-color: #60a5fa; box-shadow: 0 0 0 3px rgba(59,130,246,.15); }
.inv-cat::placeholder { color: #94a3b8; font-weight: 600; }
#catColor { padding: 2px; }

@media (max-width: 900px) {
  .inv-sel { max-width: 11rem; }
  .inv-num { width: 3.6rem; }
}




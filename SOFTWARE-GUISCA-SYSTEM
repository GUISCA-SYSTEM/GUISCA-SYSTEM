    /* ---- Movimientos recientes ---- */
    var movs = movements().slice().sort(function (a, c) {
      var da = parseDate(a.date), dc = parseDate(c.date);
      return (dc ? dc.getTime() : 0) - (da ? da.getTime() : 0);
    }).slice(0, 10);
    $('movementsTable').innerHTML = movs.length ? movs.map(function (m) {
      var p = productById(m.productId);

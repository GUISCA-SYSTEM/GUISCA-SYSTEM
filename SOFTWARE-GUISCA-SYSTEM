    }).sort(function (a, c) { return c.facturado - a.facturado; });

    var cats = {};
    soldArr.forEach(function (x) { cats[x.categoria] = (cats[x.categoria] || 0) + x.facturado; });
    var catArr = Object.keys(cats).map(function (k) {
      return { nombre: k, facturado: cats[k], pct: mes.revenue ? cats[k] / mes.revenue * 100 : 0 };
    }).sort(function (a, c) { return c.facturado - a.facturado; });

    var byPay = {};
    list30.forEach(function (s) { var k = s.payment || 'Sin definir'; byPay[k] = (byPay[k] || 0) + num(s.total); });
    var payArr = Object.keys(byPay).map(function (k) {

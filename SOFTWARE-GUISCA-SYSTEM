  /** Abre el detalle de un indicador. type: revenue | avgTicket | units | gross | cogs | perDay | distinct | avgMargin */
  function openReportDetail(type) {
    var cfg = REPORT_DETAILS[type];
    if (!cfg) return;
    var d = reportDetailData(), sum = d.sum;
    $('rdTitle').innerHTML = cfg.ico + ' ' + esc(cfg.title);
    $('rdSub').textContent = cfg.sub + ' · ' + d.label + ' · ' + sum.tickets + ' operaciones';

    var head = [], rows = [], foot = null, chips = [];

    if (type === 'revenue' || type === 'avgTicket') {
      var esAvg = type === 'avgTicket';
      var ops = d.list.slice().sort(function (a, c) {
        return esAvg ? num(c.total) - num(a.total) : String(c.date).localeCompare(String(a.date));
      });
      head = ['Fecha', 'Hora', 'Comprobante', 'Productos', 'Unidades'];
      if (esAvg) head.push('Desvío vs promedio');
      head.push('Método', 'Usuario', 'Total');
      rows = ops.map(function (s) {
        var dt = parseDate(s.date);
        var items = s.items || [];
        var u = items.reduce(function (a, i) { return a + int(i.qty); }, 0);
        var r = [(dt ? dt.toLocaleDateString('es-AR') : '—'), (dt ? dt.toLocaleTimeString('es-AR', { hour: '2-digit', minute: '2-digit' }) : '—'),
          '#' + String(s.id || '').slice(-6).toUpperCase(), items.length, u];
        if (esAvg) {
          var dif = num(s.total) - sum.avgTicket;
          r.push('<span class="' + (dif >= 0 ? 'text-emerald-600' : 'text-rose-600') + ' font-bold">' +
            (dif >= 0 ? '+' : '−') + fmtMoney(Math.abs(dif)) + '</span>');
        }
        r.push(esc(s.payment || '—'), esc(s.user || '—'),
          '<b class="font-mono">' + fmtMoney(num(s.total)) + '</b>');
        return r;
      });
      var f = new Array(head.length).fill('');
      f[head.length - 1] = '<b>TOTAL ' + fmtMoney(sum.revenue) + '</b>';
      foot = f;
      chips = [{ k: 'Facturación', v: fmtMoney(sum.revenue), tone: 'ok' },
        { k: 'Operaciones', v: sum.tickets },
        { k: 'Ticket promedio', v: fmtMoney(sum.avgTicket) }];
      if (esAvg) {
        var max = ops.length ? num(ops[0].total) : 0, min = ops.length ? num(ops[ops.length - 1].total) : 0;
        chips.push({ k: 'Ticket más alto', v: fmtMoney(max) }, { k: 'Ticket más bajo', v: fmtMoney(min) });
      }
    }

    else if (type === 'units' || type === 'distinct' || type === 'gross' || type === 'cogs' || type === 'avgMargin') {
      var por = d.prods.slice();
      if (type === 'units') por.sort(function (a, c) { return c.qty - a.qty; });
      else if (type === 'cogs') por.sort(function (a, c) { return c.cost - a.cost; });
      else if (type === 'avgMargin') por.sort(function (a, c) {
        return (c.rev ? (c.rev - c.cost) / c.rev : 0) - (a.rev ? (a.rev - a.cost) / a.rev : 0);
      });
      else por.sort(function (a, c) { return c.rev - a.rev; });

      if (type === 'units') {
        head = ['Producto', 'Categoría', 'Unidades vendidas', 'Precio promedio', 'Importe'];
        rows = por.map(function (p) {
          return [esc(p.name), esc(p.cat), '<b>' + p.qty + '</b>',
            '<span class="font-mono">' + fmtMoney(p.qty ? p.rev / p.qty : 0) + '</span>',
            '<span class="font-mono">' + fmtMoney(p.rev) + '</span>'];
        });
        foot = ['TOTAL', '', '<b>' + sum.units + '</b>', '', '<b>' + fmtMoney(sum.revenue) + '</b>'];
        chips = [{ k: 'Unidades', v: sum.units, tone: 'ok' },
          { k: 'Productos distintos', v: sum.distinct },
          { k: 'Promedio por producto', v: (sum.distinct ? Math.round(sum.units / sum.distinct) : 0) + ' u' }];
      } else if (type === 'distinct') {
        head = ['Producto', 'Categoría', 'Unidades', 'Facturación', '% de la facturación', 'Margen'];
        rows = por.map(function (p) {
          var m = p.rev ? ((p.rev - p.cost) / p.rev) * 100 : 0;
          return [esc(p.name), esc(p.cat), p.qty,
            '<span class="font-mono">' + fmtMoney(p.rev) + '</span>',
            '<span class="font-mono">' + (sum.revenue ? ((p.rev / sum.revenue) * 100).toFixed(1) : '0') + '%</span>',
            '<span class="font-mono ' + (m >= 20 ? 'text-emerald-600' : 'text-amber-600') + '">' + m.toFixed(1) + '%</span>'];
        });
        foot = ['TOTAL', '', '<b>' + sum.units + '</b>', '<b>' + fmtMoney(sum.revenue) + '</b>', '<b>100%</b>',
          '<b>' + pct(sum.grossPct) + '</b>'];
        chips = [{ k: 'Productos vendidos', v: sum.distinct, tone: 'ok' },
          { k: 'En catálogo', v: products().length },
          { k: 'Sin ventas', v: Math.max(0, products().length - sum.distinct) }];
      } else if (type === 'gross') {
        head = ['Producto', 'Unidades', 'Facturación', 'Costo', 'Margen $', 'Margen %'];
        rows = por.map(function (p) {
          var m = p.rev - p.cost, mp = p.rev ? (m / p.rev) * 100 : 0;
          return [esc(p.name), p.qty, '<span class="font-mono">' + fmtMoney(p.rev) + '</span>',
            '<span class="font-mono text-slate-400">' + fmtMoney(p.cost) + '</span>',
            '<b class="font-mono ' + (m >= 0 ? 'text-emerald-600' : 'text-rose-600') + '">' + fmtMoney(m) + '</b>',
            '<span class="font-mono">' + mp.toFixed(1) + '%</span>'];
        });
        foot = ['TOTAL', '<b>' + sum.units + '</b>', '<b>' + fmtMoney(sum.revenue) + '</b>',
          '<b>' + fmtMoney(sum.cogs) + '</b>', '<b>' + fmtMoney(sum.gross) + '</b>', '<b>' + pct(sum.grossPct) + '</b>'];
        chips = [{ k: 'Margen bruto', v: fmtMoney(sum.gross), tone: 'ok' },
          { k: 'Sobre ventas', v: pct(sum.grossPct) },
          { k: 'Costo de lo vendido', v: fmtMoney(sum.cogs) }];
      } else if (type === 'cogs') {
        head = ['Producto', 'Unidades', 'Costo unitario promedio', 'Costo total', 'Facturación'];
        rows = por.map(function (p) {
          return [esc(p.name), p.qty,
            '<span class="font-mono">' + fmtMoney(p.qty ? p.cost / p.qty : 0) + '</span>',
            '<b class="font-mono">' + fmtMoney(p.cost) + '</b>',
            '<span class="font-mono text-slate-400">' + fmtMoney(p.rev) + '</span>'];
        });
        foot = ['TOTAL', '<b>' + sum.units + '</b>', '', '<b>' + fmtMoney(sum.cogs) + '</b>', '<b>' + fmtMoney(sum.revenue) + '</b>'];
        chips = [{ k: 'Costo de mercadería', v: fmtMoney(sum.cogs), tone: 'ok' },
          { k: 'Facturación', v: fmtMoney(sum.revenue) },
          { k: 'Costo / venta', v: pct(sum.revenue ? (sum.cogs / sum.revenue) * 100 : 0) }];
      } else {
        head = ['Producto', 'Unidades', 'Facturación', 'Margen %', 'vs promedio'];
        rows = por.map(function (p) {
          var mp = p.rev ? ((p.rev - p.cost) / p.rev) * 100 : 0;
          var dif = mp - sum.grossPct;
          return [esc(p.name), p.qty, '<span class="font-mono">' + fmtMoney(p.rev) + '</span>',
            '<span class="font-mono ' + (mp >= sum.grossPct ? 'text-emerald-600' : 'text-amber-600') + '">' + mp.toFixed(1) + '%</span>',
            '<span class="font-mono ' + (dif >= 0 ? 'text-emerald-600' : 'text-rose-600') + '">' +
            (dif >= 0 ? '+' : '−') + Math.abs(dif).toFixed(1) + ' pp</span>'];
        });
        foot = ['TOTAL', '<b>' + sum.units + '</b>', '<b>' + fmtMoney(sum.revenue) + '</b>',
          '<b>' + pct(sum.grossPct) + '</b>', ''];
        chips = [{ k: 'Margen promedio', v: pct(sum.grossPct), tone: 'ok' },
          { k: 'Margen bruto', v: fmtMoney(sum.gross) },
          { k: 'Sobre ventas', v: fmtMoney(sum.revenue) }];
      }
    }

    else if (type === 'perDay') {
      head = ['Día', 'Operaciones', 'Unidades', 'Facturación', 'Ticket promedio', '% del período'];
      var dias = d.days;
      rows = dias.map(function (x) {
        var dt = parseDate(x.day);
        return [(dt ? dt.toLocaleDateString('es-AR', { weekday: 'short', day: '2-digit', month: '2-digit' }) : x.day),
          x.tickets, x.units,
          '<b class="font-mono">' + fmtMoney(x.revenue) + '</b>',
          '<span class="font-mono">' + fmtMoney(x.tickets ? x.revenue / x.tickets : 0) + '</span>',
          '<span class="font-mono">' + (sum.revenue ? ((x.revenue / sum.revenue) * 100).toFixed(1) : '0') + '%</span>'];
      });
      foot = ['<b>TOTAL</b>', '<b>' + sum.tickets + '</b>', '<b>' + sum.units + '</b>',
        '<b>' + fmtMoney(sum.revenue) + '</b>', '<b>' + fmtMoney(sum.avgTicket) + '</b>', '<b>100%</b>'];
      var mejor = dias.slice().sort(function (a, c) { return c.revenue - a.revenue; })[0];
      chips = [{ k: 'Venta por día', v: fmtMoney(d.r.days ? sum.revenue / d.r.days : sum.revenue), tone: 'ok' },
        { k: 'Días con ventas', v: dias.length + ' de ' + d.r.days },
        { k: 'Mejor día', v: mejor ? fmtMoney(mejor.revenue) + ' (' + mejor.day.slice(8) + '/' + mejor.day.slice(5, 7) + ')' : '—' }];
    }

    rdChips(chips);
    rdTable(head, rows, foot);
    State.reportDetail = { type: type, head: head, rows: rows };
    UI.modal('reportDetailModal', true);
  }

  function renderReports() {
    var b = biz(); if (!b) return;
    ensureDemoActivity();
    var r = reportRange(State.reportPeriod);
    var list = sales().filter(function (s) { return inRange(s.date, r); });
    var prev = sales().filter(function (s) { return inPrevRange(s.date, r); });
    var buys = purchases().filter(function (p) { return inRange(p.date, r); });
    var sum = summarize(list);
    var prevSum = summarize(prev);
    var delta = prevSum.revenue > 0 ? ((sum.revenue - prevSum.revenue) / prevSum.revenue) * 100 : null;

    var rangeLabel = State.reportPeriod === 'today' ? 'Hoy' : State.reportPeriod === '7' ? 'Últimos 7 días' :
      State.reportPeriod === '365' ? 'Últimos 12 meses' : 'Últimos 30 días';
    $('reportRangeLabel').textContent = rangeLabel + ' · ' + sum.tickets + ' operaciones';

    /* ---- KPIs ---- */
    var kpis = [
      { c: 'blue', ico: '💵', label: 'Facturación', val: fmtMoney(sum.revenue), sub: rangeLabel, detail: 'revenue',
        chip: delta === null ? null : { dir: delta >= 0 ? 'up' : 'down', txt: (delta >= 0 ? '▲ ' : '▼ ') + Math.abs(delta).toFixed(1) + '%' } },
      { c: 'violet', ico: '🧾', label: 'Ticket promedio', val: fmtMoney(sum.avgTicket), sub: sum.tickets + ' operaciones', detail: 'avgTicket' },
      { c: 'emerald', ico: '📦', label: 'Unidades vendidas', val: sum.units, sub: sum.distinct + ' productos distintos', detail: 'units' },
      { c: 'amber', ico: '💰', label: 'Margen bruto', val: fmtMoney(sum.gross), sub: pct(sum.grossPct) + ' sobre ventas', detail: 'gross' },
      { c: 'cyan', ico: '🏭', label: 'Costo de mercadería', val: fmtMoney(sum.cogs), sub: 'Costo de lo vendido (COGS)', detail: 'cogs' },
      { c: 'indigo', ico: '📅', label: 'Venta por día', val: fmtMoney(r.days ? sum.revenue / r.days : sum.revenue), sub: 'Promedio del período', detail: 'perDay' },
      { c: 'rose', ico: '🧺', label: 'Productos vendidos', val: sum.distinct, sub: 'De ' + products().length + ' en catálogo', detail: 'distinct' },
      { c: 'teal', ico: '📊', label: 'Margen promedio', val: pct(sum.grossPct), sub: 'Sobre el precio de venta', detail: 'avgMargin' }
    ];
    $('reportKpis').innerHTML = kpis.map(function (k) {
      var click = "openReportDetail('" + k.detail + "')";
      return '<div class="kpi kpi-click" data-c="' + k.c + '" role="button" tabindex="0" title="Ver el detalle"' +
        ' onclick="' + click + '" onkeydown="if(event.key===\'Enter\'||event.key===\' \'){event.preventDefault();' + click + '}">' +
        '<div class="kpi-top"><span class="kpi-icon">' + k.ico + '</span>' +
        (k.chip ? '<span class="kpi-chip ' + k.chip.dir + '">' + k.chip.txt + '</span>' : '') + '</div>' +
        '<div class="kpi-label">' + k.label + '</div><div class="kpi-value">' + k.val + '</div>' +
        '<div class="kpi-sub">' + k.sub + '</div><div class="kpi-more">Ver detalle →</div></div>';
    }).join('');

    /* ---- Facturación por hora / día / mes ---- */
    var byHour = new Array(24).fill(0), buckets = [], i;
    list.forEach(function (s) {
      var d = parseDate(s.date);
      if (d) byHour[d.getHours()] += num(s.total);
    });
    if (State.reportPeriod === 'today') {
      for (i = 0; i < 24; i++) buckets.push({ label: i % 3 === 0 ? i + 'h' : '', value: byHour[i] });
      $('chartDailyLabel').textContent = 'Hora por hora';
    } else if (State.reportPeriod === '7' || State.reportPeriod === '30') {
      var days = parseInt(State.reportPeriod, 10);
      for (i = days - 1; i >= 0; i--) {
        var key = dayKey(dayRange(i));
        var v = sales().filter(function (s) { return dayKey(s.date) === key; }).reduce(function (s, x) { return s + num(x.total); }, 0);
        var d = dayRange(i);
        buckets.push({ label: (days <= 7 || i % 5 === 0) ? d.getDate() + '/' + (d.getMonth() + 1) : '', value: v });
      }
      $('chartDailyLabel').textContent = 'Por día';
    } else {
      var months = ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'Jul', 'Ago', 'Sep', 'Oct', 'Nov', 'Dic'];
      for (i = 11; i >= 0; i--) {
        var dd = new Date(); dd.setDate(1); dd.setMonth(dd.getMonth() - i);
        var v2 = sales().filter(function (s) { return monthKey(s.date) === monthKey(dd); }).reduce(function (s, x) { return s + num(x.total); }, 0);
        buckets.push({ label: months[dd.getMonth()], value: v2 });
      }
      $('chartDailyLabel').textContent = 'Por mes';
    }
    renderVBars('chartReportDaily', buckets);

    /* ---- Ventas por hora ---- */
    renderVBars('chartReportHours', byHour.map(function (v, h) { return { label: h % 3 === 0 ? h + 'h' : '', value: v }; }));

    /* ---- Métodos de pago y categorías ---- */
    var byPayment = {};
    list.forEach(function (s) { var k = s.payment || 'Sin definir'; byPayment[k] = (byPayment[k] || 0) + num(s.total); });
    var payEntries = Object.keys(byPayment).map(function (k) { return { name: k, value: byPayment[k] }; }).sort(function (a, c) { return c.value - a.value; });
    renderBars('payMethodsBars', payEntries, 'Sin ventas en el período');

    var byCategory = {};
    list.forEach(function (s) {
      (s.items || []).forEach(function (it) {
        var p = productById(it.productId);
        var cat = p ? p.category : 'Sin categoría';
        byCategory[cat] = (byCategory[cat] || 0) + int(it.qty) * num(it.price);
      });
    });
    var catEntries = Object.keys(byCategory).map(function (k) { return { name: k, value: byCategory[k] }; }).sort(function (a, c) { return c.value - a.value; });
    renderDonut('reportCategoryChart', catEntries);

    /* ---- Top 10 productos ---- */
    var sold = {};
    list.forEach(function (s) {
      (s.items || []).forEach(function (it) {
        sold[it.productId] = sold[it.productId] || { qty: 0, rev: 0 };
        sold[it.productId].qty += int(it.qty);
        sold[it.productId].rev += int(it.qty) * num(it.price);
      });
    });
    var top = Object.keys(sold).map(function (id) { return { p: productById(id), qty: sold[id].qty, rev: sold[id].rev }; })
      .sort(function (a, c) { return c.rev - a.rev; }).slice(0, 10);
    var maxTop = Math.max.apply(null, [1].concat(top.map(function (x) { return x.rev; })));
    var medals = ['from-amber-300 to-amber-500', 'from-slate-300 to-slate-400', 'from-orange-300 to-orange-500'];
    $('topProductsTable').innerHTML = top.length ? top.map(function (x, i) {
      var margen = x.rev - num(x.p && x.p.cost) * x.qty;
      return '<tr>' +
        '<td><span class="w-6 h-6 rounded-full bg-gradient-to-br ' + (medals[i] || 'from-blue-300 to-blue-500') + ' text-white inline-flex items-center justify-center font-extrabold text-xs">' + (i + 1) + '</span></td>' +
        '<td><div class="font-bold">' + esc(x.p ? x.p.name : 'Producto eliminado') + '</div><div class="text-xs text-slate-400 font-mono">' + esc(x.p ? (x.p.sku || x.p.barcode) : '') + '</div></td>' +
        '<td><span class="tag tag-blue">' + esc(x.p ? x.p.category : '-') + '</span></td>' +
        '<td class="font-mono font-bold">' + x.qty + '</td>' +
        '<td class="font-mono font-bold">' + fmtMoney(x.rev) + '</td>' +
        '<td class="font-mono ' + (margen >= 0 ? 'text-emerald-600' : 'text-red-600') + '">' + fmtMoney(margen) + '</td>' +
        '<td><div class="flex items-center gap-2"><div class="bar-track" style="width:70px"><div class="bar-fill" style="width:' + (x.rev / maxTop * 100) + '%;--bf:#c4b5fd;--bf2:#7c3aed"></div></div>' +
        '<span class="text-xs font-bold">' + (sum.revenue ? Math.round(x.rev / sum.revenue * 100) : 0) + '%</span></div></td></tr>';
    }).join('') : '<tr><td colspan="7" class="text-center text-slate-400 py-6">Sin ventas registradas en el período</td></tr>';

    /* ---- Inventario ---- */
    var costValue = products().reduce(function (s, p) { return s + num(p.cost) * int(p.stock); }, 0);
    var saleValue = products().reduce(function (s, p) { return s + num(p.price) * int(p.stock); }, 0);
    var low = products().filter(function (p) { return int(p.stock) > 0 && int(p.stock) <= int(p.minStock); });
    var out = products().filter(function (p) { return int(p.stock) === 0; });
    var over = products().filter(function (p) { return int(p.minStock) > 0 && int(p.stock) > int(p.minStock) * 5; });
    var avgMargin = products().length ? products().reduce(function (s, p) {
      return s + (num(p.price) > 0 ? (num(p.price) - num(p.cost)) / num(p.price) * 100 : 0);
    }, 0) / products().length : 0;
    $('inventoryStats').innerHTML =
      miniStat('Valor de stock (costo)', fmtMoney(costValue), 'text-cyan-600') +
      miniStat('Valor de stock (venta)', fmtMoney(saleValue), 'text-emerald-600') +
      miniStat('Ganancia potencial', fmtMoney(saleValue - costValue), 'text-violet-600') +
      miniStat('Margen promedio', pct(avgMargin), 'text-amber-600') +
      miniStat('Rotación del período', (costValue > 0 ? (sum.cogs / costValue) : 0).toFixed(2) + 'x', 'text-blue-600') +
      miniStat('Bajo stock mínimo', low.length, 'text-amber-600') +
      miniStat('Agotados', out.length, 'text-rose-600') +
      miniStat('Sobre-stock (5x mín)', over.length, 'text-indigo-600');

    /* ---- Impuestos y resultado ---- */
    var totalBuys = buys.reduce(function (s, x) { return s + num(x.total); }, 0);
    var netoVentas = sum.revenue / 1.21;
    var ivaDebito = sum.revenue - netoVentas;
    var ivaCredito = totalBuys - (totalBuys / 1.21);
    $('taxStats').innerHTML =
      miniStat('Ventas netas (sin IVA)', fmtMoney(netoVentas)) +
      miniStat('IVA débito fiscal', fmtMoney(ivaDebito)) +
      miniStat('IVA crédito fiscal', fmtMoney(ivaCredito)) +
      miniStat('IVA a pagar (estimado)', fmtMoney(Math.max(0, ivaDebito - ivaCredito)), 'text-rose-600') +
      miniStat('Compras del período', fmtMoney(totalBuys), 'text-amber-600') +
      miniStat('Resultado bruto', fmtMoney(sum.gross), 'text-emerald-600');

    /* ---- Stock crítico ---- */
    var critical = out.map(function (p) { return { p: p, kind: 'Agotado', cls: 'i-rose', ico: '🚫' }; })
      .concat(low.map(function (p) { return { p: p, kind: 'Bajo mínimo', cls: 'i-amber', ico: '⚠' }; })).slice(0, 8);
    $('stockCritical').innerHTML = critical.length ? critical.map(function (x) {
      return '<div class="insight ' + x.cls + '"><span class="ico">' + x.ico + '</span><span><b>' + esc(x.p.name) + '</b> — ' + x.kind +
        ': ' + int(x.p.stock) + ' unidades (mínimo ' + int(x.p.minStock) + '). ' +
        '<a href="#" onclick="openProductForm(\'' + esc(x.p.id) + '\'); return false;" class="underline font-bold">Reponer</a></span></div>';
    }).join('') : '<div class="insight i-emerald"><span class="ico">✅</span><span>Ningún producto crítico. ¡Buen trabajo!</span></div>';

    /* ---- Compras por proveedor ---- */
    var bySupplier = {};
    buys.forEach(function (pu) { var k = pu.supplier || 'Sin proveedor'; bySupplier[k] = (bySupplier[k] || 0) + num(pu.total); });
    renderBars('purchasesBars', Object.keys(bySupplier).map(function (k) { return { name: k, value: bySupplier[k] }; })
      .sort(function (a, c) { return c.value - a.value; }), 'Sin compras registradas en el período');

    /* ---- Productos sin movimiento ---- */
    var dead = products().filter(function (p) { return !sold[p.id]; }).slice(0, 8);
    $('deadStockList').innerHTML = dead.length ? dead.map(function (p) {
      return '<div class="insight i-amber"><span class="ico">💤</span><span><b>' + esc(p.name) + '</b> — sin ventas en ' +
        rangeLabel.toLowerCase() + ' · ' + int(p.stock) + ' en stock (' + fmtMoney(num(p.cost) * int(p.stock)) + ' inmovilizado)</span></div>';
    }).join('') : '<div class="insight i-emerald"><span class="ico">✅</span><span>Todos los productos vendieron en el período</span></div>';

    /* ---- Insights automáticos ---- */
    var insights = [];
    var totalCat = catEntries.reduce(function (s, c) { return s + c.value; }, 0);
    if (catEntries.length) insights.push({ t: 'i-violet', i: '🍾', m: '<b>' + esc(catEntries[0].name) + '</b> lidera tus ventas: ' + Math.round(catEntries[0].value / totalCat * 100) + '% de la facturación (' + fmtMoney(catEntries[0].value) + ').' });
    if (sum.grossPct) insights.push({ t: 'i-emerald', i: '💰', m: 'Margen bruto del <b>' + pct(sum.grossPct) + '</b>: cada $1.000 vendidos dejan $' + Math.round(sum.grossPct * 10) + ' de ganancia.' });
    if (payEntries.length && sum.revenue > 0) insights.push({ t: 'i-blue', i: '💳', m: 'El medio más usado es <b>' + esc(payEntries[0].name) + '</b> (' + Math.round(payEntries[0].value / sum.revenue * 100) + '% de la facturación).' });
    var peak = byHour.indexOf(Math.max.apply(null, byHour));
    if (Math.max.apply(null, byHour) > 0) insights.push({ t: 'i-blue', i: '🕒', m: 'Tu hora pico son las <b>' + peak + ':00 hs</b>. Asegurá caja y personal en esa franja.' });
    if (out.length) insights.push({ t: 'i-rose', i: '🚫', m: '<b>' + out.length + ' productos agotados</b>: ' + out.slice(0, 3).map(function (p) { return esc(p.name); }).join(', ') + (out.length > 3 ? '…' : '') + '.' });
    else if (low.length) insights.push({ t: 'i-amber', i: '⚠', m: '<b>' + low.length + ' productos</b> por debajo del mínimo: ' + low.slice(0, 3).map(function (p) { return esc(p.name); }).join(', ') + (low.length > 3 ? '…' : '') + '.' });
    if (dead.length) insights.push({ t: 'i-amber', i: '💤', m: '<b>' + dead.length + ' productos sin movimiento</b> en el período: revisá precios, ubicación o promociones.' });
    if (bySupplier && Object.keys(bySupplier).length) {
      var bestSup = Object.keys(bySupplier).sort(function (a, c) { return bySupplier[c] - bySupplier[a]; })[0];
      insights.push({ t: 'i-amber', i: '🤝', m: 'Compraste <b>' + fmtMoney(totalBuys) + '</b>; tu principal proveedor fue <b>' + esc(bestSup) + '</b>.' });
    }
    if (delta !== null) insights.push({ t: delta >= 0 ? 'i-emerald' : 'i-rose', i: delta >= 0 ? '📈' : '📉', m: 'Facturación <b>' + (delta >= 0 ? 'arriba' : 'abajo') + ' ' + Math.abs(delta).toFixed(1) + '%</b> vs. el período anterior.' });
    $('insightsBox').innerHTML = insights.slice(0, 7).map(function (x, idx) {
      var limpio = String(x.m).replace(/<[^>]*>/g, '');

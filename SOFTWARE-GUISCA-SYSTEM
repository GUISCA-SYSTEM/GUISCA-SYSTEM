  /** ¿Ese email ya es de otro dueño (o del Super Admin)? Cada empresa tiene credenciales propias. */
  function ownerEmailTaken(email, exceptId) {
    var q = String(email || '').trim().toLowerCase(), sa = SuperAdmin.get();
    if (sa && sa.email === q) return true;
    return State.businesses.some(function (b) {
      return b.id !== exceptId && (b.users || []).some(function (u) { return String(u.email || '').toLowerCase() === q; });
    });
  }
  function firstVerified(list, test) {
    var i = 0;
    function next() {
      if (i >= list.length) return Promise.resolve(null);
      var c = list[i++];
      return test(c).then(function (ok) { return ok ? c : next(); });
    }
    return next();
  }
  function findOwner(uq, pass) {
    var cands = [];
    State.businesses.forEach(function (b) {
      if (b.status && b.status !== 'active') return;
      (b.users || []).forEach(function (u) {
        if (u && String(u.email || '').toLowerCase() === uq && u.passHash) cands.push({ business: b, user: u });
      });
    });
    return firstVerified(cands, function (c) { return Auth.verify(pass, Auth.of(c.user)); });
  }


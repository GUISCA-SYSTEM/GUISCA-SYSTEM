    },
    same: function (a, b) {
      a = String(a); b = String(b);
      if (a.length !== b.length) return false;
      var d = 0; for (var i = 0; i < a.length; i++) d |= a.charCodeAt(i) ^ b.charCodeAt(i);
      return d === 0;
    },
    verify: function (pass, c) {
      if (!c || !c.hash || !c.salt) return Promise.resolve(false);
      return Auth.derive(pass, c.salt, c.algo || 'pbkdf2').then(function (h) { return Auth.same(h, c.hash); }, function () { return false; });
    },
    genPass: function () {
      var abc = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnpqrstuvwxyz23456789', r = Auth.rand(12), t = '';
      for (var i = 0; i < 12; i++) t += abc.charAt(r[i] % abc.length);

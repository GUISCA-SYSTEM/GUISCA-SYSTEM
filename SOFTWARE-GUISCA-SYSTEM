  /* =========================================================
     09 · VISTAS — Ventas y carrito
     ========================================================= */
  /** Minúsculas y sin acentos: así "categoria" encuentra "Categoría". */
  function normalizar(t) {
    return String(t || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
  }

  /** Busca productos por nombre, categoría, código de barras o SKU.
      Acepta varias palabras: todas tienen que aparecer. */
  function buscarProductos(q) {
    var t = normalizar(q).trim();
    if (!t) return [];
    var palabras = t.split(/\s+/);
    return products().filter(function (p) {
      if (p.state === 'inactive') return false;
      var txt = normalizar(p.name + ' ' + (p.category || '') + ' ' + (p.barcode || '') + ' ' + (p.sku || ''));
      return palabras.every(function (w) { return txt.indexOf(w) >= 0; });
    }).slice(0, 12);
  }

  /** Suma un producto al carrito (lo usan el buscador y el catálogo rápido). */
  function agregarAlCarrito(p) {
    var existe = State.cart.filter(function (c) { return c.id === p.id; })[0];
    if (existe) existe.qty += 1;
    else State.cart.push({ id: p.id, name: p.name, barcode: p.barcode, price: num(p.price), qty: 1 });
    updateCartUI();
    UI.toast('✅ ' + p.name + ' · ' + fmtMoney(p.price), 'ok', 1800);
  }

  /** Resultados del buscador dentro del modal de escaneo. */
  function onScanSearch() {
    var box = $('scanSearchResults'); if (!box) return;
    var q = ($('scanSearch').value || '');
    if (!q.trim()) { box.classList.add('hidden'); box.innerHTML = ''; return; }
    var encontrados = buscarProductos(q);
    if (!encontrados.length) {
      box.classList.remove('hidden');
      box.innerHTML = '<div class="scan-res-empty">No encontré productos con "<b>' + esc(q) +
        '</b>". Probá con otra palabra o creado desde Productos.</div>';
      return;
    }
    box.classList.remove('hidden');
    box.innerHTML = encontrados.map(function (p) {
      return '<button type="button" onclick="pickSearchedProduct(\'' + esc(p.id) + '\')" class="scan-res-item">' +
        '<span class="scan-res-ico">' + esc(String(p.name || '?').charAt(0).toUpperCase()) + '</span>' +
        '<span class="scan-res-txt"><b>' + esc(p.name) + '</b>' +
        '<i>' + esc(p.category || 'Sin categoría') + ' · ' + fmtMoney(p.price) + ' · stock ' + int(p.stock) + '</i></span>' +
        '<span class="scan-res-add">+</span></button>';
    }).join('');
  }

  /** Eligió un producto del buscador del escáner. */
  function pickSearchedProduct(id) {
    var p = products().filter(function (x) { return x.id === id; })[0];
    if (!p) return;
    if (State.scanTarget === 'productForm') {
      $('pfBarcode').value = p.barcode || p.sku || '';
      closeScanModal();
      tryFillProductFromBarcode($('pfBarcode').value);
      return;
    }
    State.lastScan = p;
    agregarAlCarrito(p);
    var inp = $('scanSearch');
    if (inp) { inp.value = ''; inp.focus(); }
    onScanSearch();
  }

  /** Catálogo rápido de la vista de Ventas: buscá y tocalo para sumar. */
  function renderPosCatalog() {
    var box = $('posCatalog'); if (!box) return;
    if (!products().length) {
      box.innerHTML = '<div class="pos-empty">Todavía no cargaste productos. Cargalos desde <b>Productos</b> ' +
        'o con una factura de proveedor.</div>';
      return;
    }
    var q = ($('posSearch').value || '');
    var lista = q.trim() ? buscarProductos(q) : products().filter(function (p) { return p.state !== 'inactive'; });
    if (!lista.length) {
      box.innerHTML = '<div class="pos-empty">No encontré productos con "<b>' + esc(q) +
        '</b>". Probá con otra palabra o con el código de barras.</div>';
      return;
    }
    box.innerHTML = lista.slice(0, 60).map(function (p) {
      return '<button type="button" onclick="addToCartById(\'' + esc(p.id) + '\')" class="pos-card">' +
        '<span class="pos-card-ico">' + esc(String(p.name || '?').charAt(0).toUpperCase()) + '</span>' +
        '<span class="pos-card-txt"><b>' + esc(p.name) + '</b>' +

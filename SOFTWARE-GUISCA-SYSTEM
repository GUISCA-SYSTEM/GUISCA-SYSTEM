  function reportRange(p) {
    var days = p === 'today' ? 1 : (parseInt(p, 10) || 30);
    var to = new Date(); to.setHours(23, 59, 59, 999);
    var from = new Date(); from.setHours(0, 0, 0, 0);
    from.setDate(from.getDate() - (days - 1));
    var prevTo = new Date(from.getTime() - 1);
    var prevFrom = new Date(prevTo.getTime() - (days - 1) * 86400000);
    return { from: from, to: to, prevFrom: prevFrom, prevTo: prevTo, days: days };
  }
  function inRange(d, r) {
    var dt = parseDate(d);
    return !!dt && dt.getTime() >= r.from.getTime() && dt.getTime() <= r.to.getTime();
  }
  function inPrevRange(d, r) {
    var dt = parseDate(d);
    return !!dt && dt.getTime() >= r.prevFrom.getTime() && dt.getTime() <= r.prevTo.getTime();
  }

  /* =========================================================

    var out = products().filter(function (p) { return int(p.stock) === 0; });

    $('dashboardMetrics').innerHTML =
      kpi('emerald', '💵', 'Ventas de hoy', fmtMoney(sum.revenue), salesToday.length + ' transacciones', 'Hoy') +
      kpi('blue', '📦', 'Unidades vendidas', sum.units, sum.distinct + ' productos distintos') +
      kpi('amber', '🧾', 'Ticket promedio', fmtMoney(sum.avgTicket), 'Ganancia hoy: ' + fmtMoney(sum.gross)) +
      kpi('rose', '⚠', 'Stock bajo / agotado', low.length, out.length + ' agotados');

    /* Facturación de los últimos 7 días */
    var buckets = [];

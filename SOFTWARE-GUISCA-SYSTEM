  /** Verifica la licencia contra tu servidor. Sin servidor, funciona en local. */
  function licVerificar() {
    var b = biz(); if (!b) return Promise.resolve(null);
    var L = ensureLicencia();
    var ep = licEndpoint();
    if (!ep || typeof fetch !== 'function') {
      L.ultimaVerificacion = new Date().toISOString();
      L.fuente = 'local';
      return Promise.resolve(L);
    }
    return fetch(ep, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ clave: L.clave, negocioId: b.id })
    }).then(function (r) { return r.ok ? r.json() : Promise.reject(new Error('HTTP ' + r.status)); })
      .then(function (j) {
        if (j && j.activa === false) { L.estado = 'suspendida'; }
        else if (j && j.vence) { L.vence = j.vence; L.estado = j.estado || 'activa'; }
        if (j && j.plan && SAAS_PLANS[j.plan]) { L.plan = j.plan; b.plan = SAAS_PLANS[j.plan].name; }
        L.ultimaVerificacion = new Date().toISOString();
        L.fuente = 'servidor';
        DB.save();
        return L;
      }).catch(function () {
        L.ultimaVerificacion = new Date().toISOString();
        L.fuente = 'local (sin conexión)';
        return L;
      });
  }

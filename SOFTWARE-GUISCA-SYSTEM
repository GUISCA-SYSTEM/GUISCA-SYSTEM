  /** Aplica la factura: stock, costos, precios, compra y (opcional) caja. */
  function applyInvoice() {
    var b = biz(); if (!b || !State.invoice) return;
    if (!licPuede('aplicar facturas de proveedores')) return;
    var inv = State.invoice;
    var lines = inv.lines.filter(function (l) { return l.include && l.qty > 0; });
    if (!lines.length) return UI.toast('No hay renglones marcados para aplicar', 'warn');
    var now = new Date().toISOString();
    var user = (State.user && State.user.name) || 'Sistema';
    var total = 0, created = 0, updated = 0;

    lines.forEach(function (l) {
      var p = l.product;
      if (!p) {
        var cat = ensureCategory(l.category || autoCategory(l.desc));
        p = {
          id: uid('p'), name: l.desc, barcode: l.barcode || '', sku: '',
          category: cat, cost: l.cost,
          price: roundPrice(l.cost * (1 + marginFor(cat) / 100)),
          stock: 0, minStock: 5, unit: 'Unidad', iva: 21, state: 'active'
        };
        b.products.push(p);
        l.product = p;
        l.category = cat;
        created++;
      } else updated++;
      var before = int(p.stock);
      p.stock = inv.mode === 'replace' ? l.qty : Math.max(0, before + l.qty);
      if (p.category) ensureCategory(p.category);      // que la categoría exista de verdad
      l.antes = num(p.cost);                            // costo anterior, para detectar aumentos
      p.cost = l.cost;
      if (inv.updatePrices) p.price = roundPrice(l.newPrice);
      total += l.qty * l.cost;
      b.stockMovements.push({
        id: uid('m'), productId: p.id, type: 'COMPRA', qty: l.qty,
        before: before, after: p.stock, user: user, date: now, fromInvoice: true
      });
    });

    b.purchases.push({
      id: uid('pu'), date: inv.date || dayKey(), supplier: inv.supplier || 'Sin proveedor',
      number: inv.number || '', items: lines.map(function (l) {
        return { productId: l.product.id, qty: l.qty, unitCost: l.cost };
      }),
      total: total, fromInvoice: true, user: user
    });

    if (inv.payCash && total > 0 && typeof cashList === 'function') {
      cashList().push({
        id: uid('cm'), type: 'GASTO', amount: total, method: inv.payMethod === 'DIGITAL' ? 'DIGITAL' : 'EFECTIVO',
        note: 'Pago factura ' + (inv.number || inv.supplier), user: user, date: now, fromInvoice: true
      });
    }

    b.auditLogs = b.auditLogs || [];
    b.auditLogs.push({
      user: user, action: 'Factura de proveedor aplicada',
      product: inv.supplier + ' · ' + lines.length + ' renglones · ' + fmtMoney(total),
      date: new Date().toLocaleString('es-AR')
    });

    var aumentos = detectarAumentosCosto(lines);
    if (aumentos.length) {
      registrarAumentosCosto(aumentos);
      b.auditLogs.push({
        user: user, action: 'Aumento de costo detectado',
        product: aumentos.map(function (a) {
          return a.nombre + ' ' + fmtMoney(a.anterior) + ' a ' + fmtMoney(a.nuevo) + ' (+' + a.pct.toFixed(1) + '%)';
        }).join(' · '),
        date: new Date().toLocaleString('es-AR')
      });
    }
    DB.save();
    UI.modal('invoiceModal', false);
    State.invoice = null;
    safe(renderPurchases, 'listar compras');
    if (State.view === 'products') safe(renderProducts, 'listar productos');
    if (State.view === 'dashboard') safe(renderDashboard, 'dashboard');
    if (typeof renderCashPanel === 'function') renderCashPanel();
    if (typeof updateNavBadges === 'function') updateNavBadges();
    UI.toast('Factura aplicada: ' + created + ' productos nuevos, ' + updated +
      ' actualizados · ' + fmtMoney(total), 'ok', 6000);
    if (aumentos.length) {
      UI.toast('Aumento de costo en ' + aumentos.length + ' producto(s): ' +
        aumentos.slice(0, 3).map(function (a) { return a.nombre + ' +' + a.pct.toFixed(1) + '%'; }).join(', ') +
        (aumentos.length > 3 ? '…' : '') + '. Revisá el precio de venta.', 'warn', 9000);
    }
  }


/* ---------- 12.5 · CAJA DEL DÍA ---------- */
.cash-wrap { background: var(--surface); border: 1px solid var(--border); border-radius: 20px; padding: 1.1rem 1.15rem 1.15rem; box-shadow: var(--shadow); }
.cash-grid { display: grid; gap: .7rem; margin-bottom: .7rem; }
.cash-grid-3 { grid-template-columns: 1fr; }
.cash-grid-4 { grid-template-columns: 1fr; }
@media (min-width: 640px) {
  .cash-grid-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .cash-grid-4 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
@media (min-width: 1024px) { .cash-grid-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); } }

.cash-card { border-radius: 14px; padding: .8rem .9rem; border: 1px solid; display: flex; flex-direction: column; gap: .1rem; min-width: 0; }
.cash-card .cc-label { font-size: .58rem; font-weight: 900; letter-spacing: .09em; text-transform: uppercase; }
.cash-card .cc-val { font-size: 1.5rem; font-weight: 900; letter-spacing: -.02em; line-height: 1.15; }
.cash-card .cc-sub { font-size: .66rem; font-weight: 600; opacity: .8; }
.cash-card.c-amber   { background: #fffbeb; border-color: #fde68a; color: #92400e; }
.cash-card.c-blue    { background: #eff6ff; border-color: #bfdbfe; color: #1e40af; }
.cash-card.c-emerald { background: #ecfdf5; border-color: #a7f3d0; color: #065f46; }
.cash-card.c-green   { background: #f0fdf4; border-color: #bbf7d0; color: #15803d; }
.cash-card.c-rose    { background: #fff1f2; border-color: #fecdd3; color: #9f1239; }
.cash-card.c-indigo  { background: #eef2ff; border-color: #c7d2fe; color: #3730a3; }
.cash-card.c-orange  { background: #fff7ed; border-color: #fed7aa; color: #9a3412; }

.cash-result {
  border-radius: 16px; padding: .95rem 1.2rem; color: #fff;
  background: linear-gradient(120deg, #4f46e5 0%, #6366f1 45%, #8b5cf6 100%);
  display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
  box-shadow: 0 14px 28px -16px rgba(79, 70, 229, .8);
}
.cash-result .cr-label { font-size: .66rem; font-weight: 900; letter-spacing: .12em; text-transform: uppercase; opacity: .9; }
.cash-result .cr-sub { font-size: .74rem; font-weight: 600; opacity: .85; }
.cash-result .cr-val { font-size: 1.9rem; font-weight: 900; letter-spacing: -.02em; }

.cash-actions { display: flex; flex-wrap: wrap; gap: .55rem; margin-top: .8rem; }
.btn-cash {
  flex: 1 1 150px; border: none; cursor: pointer; border-radius: 12px; padding: .7rem .9rem;
  font-weight: 800; font-size: .82rem; color: #fff; display: inline-flex; align-items: center;
  justify-content: center; gap: .35rem; transition: transform .14s ease, filter .14s ease;
}
.btn-cash:hover { transform: translateY(-2px); filter: brightness(1.05); }
.btn-cash:active { transform: scale(.98); }
.btn-cash.bc-blue   { background: linear-gradient(135deg, #2563eb, #3b82f6); box-shadow: 0 10px 20px -12px rgba(37, 99, 235, .9); }
.btn-cash.bc-red    { background: linear-gradient(135deg, #dc2626, #ef4444); box-shadow: 0 10px 20px -12px rgba(220, 38, 38, .9); }
.btn-cash.bc-indigo { background: linear-gradient(135deg, #4338ca, #6366f1); box-shadow: 0 10px 20px -12px rgba(67, 56, 202, .9); }
.btn-cash.bc-orange { background: linear-gradient(135deg, #ea580c, #f97316); box-shadow: 0 10px 20px -12px rgba(234, 88, 12, .9); }
.btn-cash.bc-slate  { background: linear-gradient(135deg, #0f172a, #334155); box-shadow: 0 10px 20px -12px rgba(15, 23, 42, .9); }

/* ---------- 12.6 · CIERRE DE CAJA ---------- */
.cc-title { font-size: .68rem; font-weight: 900; letter-spacing: .1em; text-transform: uppercase; color: #94a3b8; margin-bottom: .45rem; }
.cc-box { border: 1px solid var(--border); border-radius: 14px; background: #f8fafc; padding: .5rem .6rem; }
.cc-box-tall { max-height: 220px; overflow-y: auto; }
.cc-row { display: flex; align-items: center; justify-content: space-between; gap: .75rem; padding: .38rem .45rem; border-radius: 9px; font-size: .8rem; color: #475569; }
.cc-row:nth-child(odd) { background: #fff; }
.cc-row b { font-family: 'JetBrains Mono', ui-monospace, monospace; color: #0f172a; }
.cc-row.cc-strong { background: #eef2ff; font-weight: 800; color: #1e1b4b; margin-top: .15rem; }
.cc-row.cc-strong b { color: #3730a3; }
.cc-mov { display: flex; align-items: center; gap: .5rem; padding: .35rem .4rem; font-size: .74rem; border-bottom: 1px dashed #eef2f7; }
.cc-mov:last-child { border-bottom: 0; }
.cc-mov-t { font-weight: 900; font-size: .6rem; letter-spacing: .05em; background: #e2e8f0; color: #475569; border-radius: 6px; padding: .1rem .35rem; flex-shrink: 0; }
.cc-mov-n { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #64748b; }
.cc-mov-m { font-size: .62rem; font-weight: 800; color: #0891b2; flex-shrink: 0; }
.cc-mov-h { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: .66rem; color: #94a3b8; flex-shrink: 0; }
.cc-mov-a { font-family: 'JetBrains Mono', ui-monospace, monospace; font-weight: 800; flex-shrink: 0; }
.cc-diff-box { display: flex; align-items: center; justify-content: space-between; gap: .5rem; border: 1px dashed var(--border); border-radius: 12px; padding: .55rem .7rem; background: #f8fafc; }
.cc-diff { font-weight: 900; font-size: .9rem; }
.cc-diff.ok { color: #047857; }
.cc-diff.up { color: #1d4ed8; }
.cc-diff.down { color: #be123c; }

/* ---------- 12.7 · BOTÓN PDF DE SECCIÓN ---------- */
.pdf-btn {
  width: 27px; height: 27px; border-radius: 9px; background: #fff; border: 1px solid var(--border);

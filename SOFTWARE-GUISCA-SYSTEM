/* Barras horizontales (métodos, categorías, etc.) */
.bar-row { display: grid; grid-template-columns: minmax(88px, 26%) 1fr auto; align-items: center; gap: .6rem; padding: .3rem 0; }
.bar-row .bar-label { font-size: .8rem; font-weight: 700; color: #334155; display: flex; align-items: center; gap: .35rem; min-width: 0; }
.bar-row .bar-label span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.bar-track { height: 10px; border-radius: 99px; background: #f1f5f9; overflow: hidden; }

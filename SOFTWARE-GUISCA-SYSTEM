.vbars .vcol:hover .vbar::after { opacity: 1; }
.vbars .vcol .vlab { font-size: 10px; font-weight: 700; color: #64748b; white-space: nowrap; }

/* Donut */
.donut-wrap { display: flex; align-items: center; gap: 1.1rem; flex-wrap: wrap; }
.donut { width: 148px; height: 148px; border-radius: 50%; position: relative; flex-shrink: 0; }
.donut::after { content: ''; position: absolute; inset: 24px; border-radius: 50%; background: #fff; box-shadow: inset 0 0 0 1px rgba(226,232,240,.9); }
.donut-center { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; z-index: 2; }
.donut-center b { font-size: 1.05rem; font-weight: 800; color: #0f172a; line-height: 1.1; }
.donut-center small { font-size: .6rem; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: .05em; }
.legend { display: flex; flex-direction: column; gap: .35rem; min-width: 130px; flex: 1; }
.legend-item { display: flex; align-items: center; gap: .45rem; font-size: .78rem; }
.legend-item .dot { width: 10px; height: 10px; border-radius: 3px; flex-shrink: 0; }
.legend-item .lg-name { font-weight: 700; color: #334155; flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.legend-item .lg-val { font-weight: 800; color: #0f172a; font-variant-numeric: tabular-nums; }

/* Insights / alertas */
.insight { display: flex; gap: .6rem; align-items: flex-start; padding: .6rem .7rem; border-radius: 12px; font-size: .8rem; line-height: 1.4; border: 1px solid transparent; }
.insight b { font-weight: 800; }
.insight.i-blue { background: #eff6ff; color: #1e3a8a; border-color: #bfdbfe; }
.insight.i-emerald { background: #ecfdf5; color: #065f46; border-color: #a7f3d0; }
.insight.i-amber { background: #fffbeb; color: #92400e; border-color: #fde68a; }
.insight.i-rose { background: #fff1f2; color: #9f1239; border-color: #fecdd3; }
.insight.i-violet { background: #f5f3ff; color: #5b21b6; border-color: #ddd6fe; }
.insight .ico { font-size: 1rem; line-height: 1.2; }

/* Mini stat dentro de paneles */
.mini-stat { background: #fff; border: 1px solid var(--border); border-radius: 12px; padding: .6rem .7rem; }
.mini-stat .ms-label { font-size: .62rem; font-weight: 800; letter-spacing: .05em; text-transform: uppercase; color: #94a3b8; }
.mini-stat .ms-value { font-size: 1.05rem; font-weight: 800; color: #0f172a; letter-spacing: -.02em; }

/* Segmento de período */
.seg { display: inline-flex; gap: .2rem; background: #f1f5f9; padding: .22rem; border-radius: 12px; border: 1px solid var(--border); }
.seg button { padding: .35rem .7rem; border-radius: 9px; font-size: .75rem; font-weight: 800; color: #64748b; background: transparent; border: none; cursor: pointer; transition: all .15s; white-space: nowrap; }
.seg button:hover { color: #0f172a; }
.seg button.on { background: #fff; color: #1d4ed8; box-shadow: 0 1px 3px rgba(15,23,42,.12); }

/* Scrollbar */
::-webkit-scrollbar { width: 8px; height: 8px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 99px; }
::-webkit-scrollbar-thumb:hover { background: #94a3b8; }

/* Toques de color generales */
#mainContent h2 { display: flex; align-items: center; gap: .6rem; }
#mainContent h2::before { content: ''; width: 6px; height: 26px; border-radius: 99px; background: linear-gradient(180deg, #2563eb, #7c3aed); box-shadow: 0 0 12px rgba(99,102,241,.55); flex-shrink: 0; }
.table thead th { background: linear-gradient(180deg, #f8fafc, #eef2f7); }
.card { transition: box-shadow .2s ease, transform .15s ease, border-color .2s ease; }
.card:hover { border-color: #dbeafe; }
.login-orb { position: absolute; border-radius: 50%; filter: blur(70px); opacity: .55; pointer-events: none; }

/* ---------- 09 · LECTOR DE CÓDIGO DE BARRAS ---------- */
/* ================= LECTOR DE CÓDIGO DE BARRAS ================= */
@keyframes scanLaser {
  0%, 100% { top: 6%; opacity: .3; }
  10% { opacity: 1; }
  50% { top: calc(94% - 3px); opacity: 1; }
  60% { opacity: .3; }
}
@keyframes scanFlashRing {
  0% { box-shadow: inset 0 0 0 0 rgba(16,185,129,.95), 0 0 0 0 rgba(16,185,129,.45); }
  100% { box-shadow: inset 0 0 0 8px rgba(16,185,129,0), 0 0 0 22px rgba(16,185,129,0); }
}
@keyframes popIn { from { opacity: 0; transform: translateY(8px) scale(.97); } to { opacity: 1; transform: none; } }
@keyframes dotPulse { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: .3; transform: scale(.75); } }

.scan-viewport {
  position: relative; width: 100%; aspect-ratio: 4 / 3; border-radius: 20px; overflow: hidden;
  background: radial-gradient(130% 120% at 50% 0%, #1e293b 0%, #0f172a 55%, #020617 100%);
  box-shadow: inset 0 0 0 1px rgba(255,255,255,.07), 0 20px 45px -22px rgba(2,6,23,.75);
}
@media (min-width: 640px) { .scan-viewport { aspect-ratio: 16 / 10; } }
.scan-viewport video, .scan-viewport .quagga-host video {
  position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; background: #000; display: block;
}
.scan-viewport video.hidden, .scan-viewport .quagga-host.hidden { display: none; }
.scan-viewport .quagga-host { position: absolute; inset: 0; }
.scan-viewport .quagga-host canvas { position: absolute; inset: 0; width: 100% !important; height: 100% !important; }
.scan-viewport::after {
  content: ''; position: absolute; inset: 0; pointer-events: none; z-index: 2;
  background: radial-gradient(115% 85% at 50% 50%, transparent 52%, rgba(2,6,23,.62) 100%);
}
.scan-reticle { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: min(74%, 330px); aspect-ratio: 1 / 1; z-index: 3; transition: opacity .25s ease; }
.scan-reticle.scan-dim { opacity: 0; }
.scan-reticle i { position: absolute; width: 30px; height: 30px; border: 3px solid #34d399; box-shadow: 0 0 14px rgba(52,211,153,.5); }
.scan-reticle i.tl { top: 0; left: 0; border-right: 0; border-bottom: 0; border-top-left-radius: 14px; }
.scan-reticle i.tr { top: 0; right: 0; border-left: 0; border-bottom: 0; border-top-right-radius: 14px; }
.scan-reticle i.bl { bottom: 0; left: 0; border-right: 0; border-top: 0; border-bottom-left-radius: 14px; }
.scan-reticle i.br { bottom: 0; right: 0; border-left: 0; border-top: 0; border-bottom-right-radius: 14px; }
.scan-laser { position: absolute; left: 8px; right: 8px; top: 6%; height: 3px; border-radius: 99px;
  background: linear-gradient(90deg, transparent, #6ee7b7, #34d399, #6ee7b7, transparent);
  box-shadow: 0 0 18px rgba(52,211,153,.9); animation: scanLaser 2.4s cubic-bezier(.45,.05,.55,.95) infinite; }
.scan-status { position: absolute; top: 12px; left: 50%; transform: translateX(-50%); z-index: 4; display: inline-flex; align-items: center; gap: .45rem; padding: .35rem .8rem; border-radius: 999px; background: rgba(2,6,23,.62); backdrop-filter: blur(8px); color: #e2e8f0; font-size: .72rem; font-weight: 700; border: 1px solid rgba(255,255,255,.14); white-space: nowrap; max-width: 94%; overflow: hidden; text-overflow: ellipsis; }
.scan-status .dot { width: 8px; height: 8px; border-radius: 99px; background: #34d399; box-shadow: 0 0 10px #34d399; flex-shrink: 0; }
.scan-status[data-state="loading"] .dot { background: #fbbf24; box-shadow: 0 0 10px #fbbf24; animation: dotPulse 1.1s ease-in-out infinite; }
.scan-status[data-state="error"] .dot { background: #f87171; box-shadow: 0 0 10px #f87171; }
.scan-status[data-state="ok"] .dot { background: #34d399; }
.scan-hint { position: absolute; left: 14px; bottom: 14px; z-index: 4; color: rgba(226,232,240,.9); font-size: .72rem; font-weight: 600; text-shadow: 0 1px 8px rgba(0,0,0,.7); max-width: 58%; transition: opacity .25s; }
.scan-hint.scan-dim { opacity: 0; }
.scan-tools { position: absolute; right: 10px; bottom: 10px; z-index: 4; display: flex; gap: .5rem; }
.scan-tool { width: 42px; height: 42px; border-radius: 14px; background: rgba(2,6,23,.55); backdrop-filter: blur(8px); border: 1px solid rgba(255,255,255,.16); color: #e2e8f0; font-size: 1.05rem; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: transform .12s ease, background .15s ease, color .15s ease; }
.scan-tool:hover { background: rgba(2,6,23,.78); }
.scan-tool:active { transform: scale(.92); }
.scan-tool.on { background: #34d399; color: #052e21; border-color: transparent; box-shadow: 0 6px 16px -6px rgba(52,211,153,.8); }
.scan-error { position: absolute; inset: 0; z-index: 6; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .55rem; text-align: center; padding: 1.4rem; background: rgba(2,6,23,.86); backdrop-filter: blur(6px); color: #e2e8f0; }
.scan-error p { font-size: .82rem; color: #cbd5e1; line-height: 1.45; max-width: 20rem; margin: 0; }
.scan-viewport.flash { animation: scanFlashRing .65s ease-out; }
.scan-result { border: 1.5px solid #a7f3d0; background: linear-gradient(135deg, #ecfdf5, #f0fdfa); border-radius: 16px; padding: .9rem; }
.scan-thumb { width: 44px; height: 44px; border-radius: 14px; background: linear-gradient(135deg, #34d399, #059669); color: #fff; font-weight: 800; font-size: 1.1rem; display: flex; align-items: center; justify-content: center; box-shadow: 0 8px 16px -6px rgba(5,150,105,.65); flex-shrink: 0; }
.scan-stat { background: #fff; border: 1px solid #d1fae5; border-radius: 12px; padding: .5rem .35rem; text-align: center; }
.scan-stat .label { font-size: .62rem; font-weight: 800; letter-spacing: .05em; text-transform: uppercase; color: #64748b; }
.scan-stat .value { font-weight: 800; font-size: 1.05rem; }
.scan-stat.amber { border-color: #fde68a; background: #fffbeb; }
.scan-stat.red { border-color: #fecaca; background: #fef2f2; }
.scan-stat.green { border-color: #a7f3d0; background: #ecfdf5; }
.pop { animation: popIn .28s cubic-bezier(.22,1,.36,1); }
.manual-row { display: flex; gap: .5rem; }
.manual-row .input { flex: 1 1 auto; min-width: 0; }
.scan-modal { max-width: 32rem; }
@media (max-width: 640px) { .scan-modal { max-width: none; } }


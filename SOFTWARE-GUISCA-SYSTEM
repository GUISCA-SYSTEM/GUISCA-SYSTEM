    }).join('') : '<div class="text-sm text-slate-400">Sin datos aún</div>';

    var totalCat = catEntries.reduce(function (s, c) { return s + c.value; }, 0);
    if (totalCat > 0) {
      var acc = 0;
      var stops = catEntries.map(function (c, i) {
        var col = categoryColor(c.name, i), from = acc / totalCat * 100; acc += c.value;
        return col + ' ' + from + '% ' + (acc / totalCat * 100) + '%';

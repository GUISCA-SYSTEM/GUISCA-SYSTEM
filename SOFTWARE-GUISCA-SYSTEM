  function registrarAumentosCosto(cambios) {
    var b = biz(); if (!b || !cambios || !cambios.length) return;
    b.costAlerts = b.costAlerts || [];
    cambios.forEach(function (c) {
      b.costAlerts.push({ nombre: c.nombre, anterior: c.anterior, nuevo: c.nuevo, pct: c.pct, fecha: dayKey() });
    });
    if (b.costAlerts.length > 40) b.costAlerts = b.costAlerts.slice(-40);
  }
  /** Compara el costo anterior con el nuevo y devuelve los aumentos (cálculo del sistema).
   *  El costo anterior se captura antes de sobrescribirlo (campo "antes"). */
  function detectarAumentosCosto(lineas) {
    var out = [];
    (lineas || []).forEach(function (l) {
      var p = l.product;
      if (!p) return;
      var anterior = l.antes !== undefined ? num(l.antes) : num(p.cost);
      var nuevo = num(l.cost);
      if (anterior > 0 && nuevo > anterior * 1.001) {
        out.push({ nombre: p.name, anterior: anterior, nuevo: nuevo, pct: (nuevo - anterior) / anterior * 100 });
      }
    });
    return out;
  }


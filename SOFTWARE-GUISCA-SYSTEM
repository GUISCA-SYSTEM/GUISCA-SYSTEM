  /* =========================================================
     16 · ESCÁNER REMOTO — celular ➜ PC en vivo (P2P, sin guardar datos en servidores)
     La PC muestra un código; el celular lo ingresa y envía lo que escanea.
     El celular NO recibe costos ni datos del negocio: solo nombre, precio y stock.
     ========================================================= */
  var Remote = {
    peer: null, conn: null, role: '', code: '', feed: [], auto: false, rate: 0, stream: null, timer: null, lastCode: '', lastAt: 0, phoneMsg: '',
    ABC: 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789',
    newCode: function () { var a = new Uint8Array(8), s = '', i; crypto.getRandomValues(a); for (i = 0; i < 8; i++) s += this.ABC[a[i] % 32]; return s; },
    ok: function () { if (typeof Peer === 'undefined') { UI.toast('No cargó PeerJS: revisá la conexión a internet.', 'error', 5000); return false; } return true; },
    stop: function () {
      this.stopCam();
      try { if (this.conn) this.conn.close(); } catch (e) {}
      try { if (this.peer) this.peer.destroy(); } catch (e) {}
      this.peer = null; this.conn = null; this.role = ''; this.code = ''; this.paint();
    },
    isOpen: function () { return !!(this.conn && this.conn.open); },

    /* ---------- PC (anfitrión) ---------- */
    startHost: function () {
      if (!this.ok()) return;
      var self = this; this.stop(); this.code = this.newCode(); this.role = 'pc';
      this.peer = new Peer('gsc-' + this.code, { debug: 0 });
      this.peer.on('open', function () { self.paint(); });
      this.peer.on('error', function (e) { UI.toast('Error de conexión: ' + ((e && e.type) || e), 'error', 4500); self.paint(); });
      this.peer.on('connection', function (c) {
        if (self.isOpen()) { c.close(); return; }
        if (!UI.confirm('Un celular quiere conectarse como escáner usando tu código. ¿Permitir?')) { c.close(); return; }
        self.conn = c;
        c.on('open', function () { c.send({ t: 'hi', biz: (biz() && biz().name) || '' }); self.paint(); UI.toast('📱 Celular conectado', 'ok'); });
        c.on('data', function (m) { self.onHost(m); });
        c.on('close', function () { if (self.conn === c) self.conn = null; self.paint(); UI.toast('Celular desconectado', 'warn'); });
      });
      this.paint();
    },
    onHost: function (m) {
      if (!m || m.t !== 'scan') return;
      var now = Date.now(); if (now - this.rate < 150) return; this.rate = now;
      var code = String(m.code || '').trim().slice(0, 64); if (!code) return;
      var p = products().filter(function (x) { return (x.barcode && x.barcode === code) || (x.sku && String(x.sku).toLowerCase() === code.toLowerCase()); })[0];
      var it = { code: code, at: now, found: !!p, id: p ? p.id : '', name: p ? p.name : '', price: p ? num(p.price) : 0, stock: p ? int(p.stock) : 0 };
      this.feed.unshift(it); if (this.feed.length > 30) this.feed.length = 30;
      if (p && this.auto) safe(function () { agregarAlCarrito(p); }, 'escáner remoto');
      beep(p ? 920 : 300); this.paint();
      try { if (this.isOpen()) this.conn.send({ t: 'res', code: code, found: it.found, name: it.name, price: it.price, stock: it.stock }); } catch (e) {}
    },
    addFeed: function (i) {
      var it = this.feed[i]; if (!it || !it.id) return;
      var p = products().filter(function (x) { return x.id === it.id; })[0];
      if (p) { agregarAlCarrito(p); UI.toast('Agregado al carrito', 'ok', 1200); }
    },
    clearFeed: function () { this.feed = []; this.paint(); },

    /* ---------- Celular (escáner) ---------- */
    join: function (code) {
      if (!this.ok()) return;
      code = String(code || '').toUpperCase().replace(/[^A-Z0-9]/g, '');
      if (code.length !== 8) { this.setPhone('El código tiene 8 caracteres.', true); return; }
      var self = this; this.stop(); this.role = 'phone'; this.code = code;
      this.setPhone('Conectando…');
      this.peer = new Peer({ debug: 0 });
      this.peer.on('error', function (e) { self.setPhone('No se pudo conectar (' + ((e && e.type) || 'error') + '). Revisá el código.', true); });
      this.peer.on('open', function () {
        var c = self.peer.connect('gsc-' + code, { reliable: true, serialization: 'json' });
        self.conn = c;
        c.on('open', function () { self.setPhone('✅ Conectado a la PC', false); self.startCam(); });
        c.on('data', function (m) {
          if (!m) return;
          if (m.t === 'res') self.setPhone(m.found ? ('✅ ' + m.name + ' · ' + fmtMoney(m.price) + ' · stock ' + m.stock) : ('⚠ No encontrado: ' + m.code), !m.found);
          if (m.t === 'hi' && m.biz) self.setPhone('✅ Conectado a: ' + m.biz, false);
        });
        c.on('close', function () { self.stopCam(); self.setPhone('Desconectado de la PC.', true); });
        setTimeout(function () { if (!self.isOpen() && self.role === 'phone') self.setPhone('La PC no respondió. ¿Está abierto el código y aprobaste en la PC?', true); }, 15000);
      });
    },
    send: function (code) {
      code = String(code || '').trim(); if (!code || !this.isOpen()) return;
      var now = Date.now(); if (code === this.lastCode && now - this.lastAt < 1800) return;
      this.lastCode = code; this.lastAt = now; beep(920); vibrate(55);
      try { this.conn.send({ t: 'scan', code: code }); } catch (e) {}
    },
    startCam: function () {
      var self = this, v = $('gsPhoneVideo'); if (!v || !navigator.mediaDevices) return;
      navigator.mediaDevices.getUserMedia({ video: { facingMode: 'environment' }, audio: false }).then(function (s) {
        self.stream = s; v.srcObject = s; v.play();
        var det = null;
        try { if (window.BarcodeDetector) det = new BarcodeDetector({ formats: ['ean_13', 'ean_8', 'upc_a', 'upc_e', 'code_128', 'code_39', 'qr_code'] }); } catch (e) { det = null; }
        var cv = document.createElement('canvas'), busy = false;
        self.timer = setInterval(function () {
          if (busy || !self.isOpen() || !v.videoWidth) return; busy = true;
          if (det) {
            det.detect(v).then(function (r) { if (r && r[0]) self.send(r[0].rawValue); }).catch(function () {}).then(function () { busy = false; });
          } else if (window.Quagga && Quagga.decodeSingle) {

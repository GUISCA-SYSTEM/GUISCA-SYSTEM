  ];

  function roleInfo(id) {
    if (id === 'PERSONALIZADO') return CUSTOM_ROLE;
    for (var i = 0; i < EMPLOYEE_ROLES.length; i++) if (EMPLOYEE_ROLES[i].id === id) return EMPLOYEE_ROLES[i];
    return null;
  }
  function roleName(id) { var r = roleInfo(id); return r ? r.name : 'Empleado'; }
  /** Nombre legible de una seccion, para mostrar en los permisos. */
  function viewName(id) {
    for (var i = 0; i < EMPLOYEE_VIEWS.length; i++) if (EMPLOYEE_VIEWS[i].id === id) return EMPLOYEE_VIEWS[i].name;
    return id;
  }
  /** Secciones habilitadas de un empleado (respeta el rol personalizado). */
  function employeeViews(e) {
    if (!e) return [];
    if (e.role === 'PERSONALIZADO') return (e.views || []).slice();
    var r = roleInfo(e.role);
    return (r && r.views) ? r.views.slice() : [];
  }
  /** El empleado de la sesion abierta, para resolver permisos personalizados. */
  function sessionEmployee() {
    var u = State.user;
    if (!u || u.role === 'OWNER' || u.role === 'SUPER_ADMIN') return null;
    var b = biz(); if (!b) return null;
    if (u.employeeId) {
      var porId = (b.employees || []).filter(function (e) { return e.id === u.employeeId; })[0];
      if (porId) return porId;
    }
    var user = String(u.email || '').replace(/@empleado\.local$/, '').toLowerCase();
    return (b.employees || []).filter(function (e) {
      return String(e.username || '').toLowerCase() === user;
    })[0] || null;
  }
  /** Casilleros marcados en el formulario de permisos. */
  function checkedViews(sel) {
    return $$(sel).filter(function (c) { return c.checked; }).map(function (c) { return c.value; });
  }
  function toggleAllBoxes(sel, on) { $$(sel).forEach(function (c) { c.checked = !!on; }); }
  function toggleAllEmpViews(on) { toggleAllBoxes('.emp-view-cb', on); }
  function toggleAllEmpPerms(on) { toggleAllBoxes('.emp-perm-cb', on); }

  /** Control de acceso por rol. El dueño y el super admin siempre pasan. */
  function canAccess(view) {
    var r = State.user && State.user.role;
    if (!r || r === 'OWNER' || r === 'SUPER_ADMIN') return true;
    if (view === 'employees' || view === 'settings') return false;
    if (r === 'PERSONALIZADO') return employeeViews(sessionEmployee()).indexOf(view) >= 0;
    var role = roleInfo(r);
    return !!role && role.views.indexOf(view) >= 0;
  }

  /** Busca un empleado por usuario y contraseña (promesa: empleado encontrado o null). */
  function findEmployee(user, pass) {
    var q = String(user || '').trim().toLowerCase();
    if (!q || !pass) return Promise.resolve(null);
    var cands = [];
    State.businesses.forEach(function (b) {
      if (b.status && b.status !== 'active') return;
      if (!employeesModuleOn() || b.employeesEnabled === false) return;
      (b.employees || []).forEach(function (e) {
        if (!e || e.active === false) return;
        if (String(e.username || '').toLowerCase() === q) cands.push({ business: b, employee: e });
      });
    });
    return firstVerified(cands, function (c) {
      var e = c.employee;
      if (e.passHash) return Auth.verify(pass, Auth.of(e));
      if (e.password && Auth.same(e.password, pass)) {   // cuenta antigua: se convierte a hash al entrar
        Auth.make(pass).then(function (cr) { Auth.apply(e, cr); DB.save(); });
        return Promise.resolve(true);
      }
      return Promise.resolve(false);
    });
  }

  /** Devuelve true si el empleado pudo entrar y dejó la sesión abierta. */
  function loginAsEmployee(found) {
    var b = found.business, e = found.employee;
    State.business = b;
    State.user = {
      email: e.username + '@empleado.local', name: e.name, role: e.role || 'CAJERO',
      businessId: b.id, employeeId: e.id
    };
    e.lastLogin = new Date().toISOString();
    e.logins = int(e.logins) + 1;
    DB.save();
    enterApp();
    return true;
  }


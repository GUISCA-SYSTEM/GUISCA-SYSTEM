  /** Resumen de ventas de un conjunto de tickets. */
  function summarize(list) {
    var s = { revenue: 0, units: 0, tickets: 0, cogs: 0, lines: 0, distinct: 0 };
    var seen = {};
    (list || []).forEach(function (x) {
      s.revenue += num(x.total); s.tickets++;
      (x.items || []).forEach(function (i) {
        var p = productById(i.productId);
        s.units += int(i.qty); s.lines++;
        s.cogs += num(p && p.cost) * int(i.qty);
        if (i.productId && !seen[i.productId]) { seen[i.productId] = true; s.distinct++; }
      });
    });
    s.gross = s.revenue - s.cogs;
    s.grossPct = s.revenue ? (s.gross / s.revenue) * 100 : 0;
    s.avgTicket = s.tickets ? s.revenue / s.tickets : 0;
    return s;
  }
  function salesBetween(from, to) {
    var f = from.getTime(), t = to.getTime();
    return sales().filter(function (s) {
      var d = parseDate(s.date); return d && d.getTime() >= f && d.getTime() <= t;
    });
  }
  function dayRange(offset) {
    var d = new Date(); d.setHours(0, 0, 0, 0); d.setDate(d.getDate() - (offset || 0));
    return d;
  }


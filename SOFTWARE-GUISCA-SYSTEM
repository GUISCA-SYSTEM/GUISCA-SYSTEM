    var sem = aiPeriod(7), mes = summarize(list30);
    var mesCal = aiMonth(0), mesAnt = aiMonth(-1);
    var cajaHoy = aiCash(1), cajaMes = aiCash(30);

    var sold = {};
    list30.forEach(function (s) {
      (s.items || []).forEach(function (it) {
        var k = it.productId || ('sin-id-' + (productById(it.productId) ? productById(it.productId).name : 'eliminado'));
        sold[k] = sold[k] || { qty: 0, rev: 0 };
        sold[k].qty += int(it.qty);
        sold[k].rev += int(it.qty) * num(it.price);
      });
    });
    var prods = products();
    var soldArr = Object.keys(sold).map(function (k) {
      var p = productById(k);
      return { nombre: p ? p.name : 'Producto eliminado', unidades: sold[k].qty, facturado: sold[k].rev,
        categoria: p ? (p.category || 'Sin categoría') : '—',

  #rdFoot td { background: #f8fafc; font-weight: 800; border-top: 2px solid var(--border); position: sticky; bottom: 0; }
#rdHead th { position: sticky; top: 0; background: #f8fafc; z-index: 1; }
.kpi-top { display: flex; align-items: center; justify-content: space-between; gap: .5rem; margin-bottom: .55rem; }
.kpi-icon { width: 42px; height: 42px; border-radius: 13px; display: inline-flex; align-items: center; justify-content: center; font-size: 1.2rem; background: var(--kpi-soft, #eff6ff); color: var(--kpi, #2563eb); flex-shrink: 0; }

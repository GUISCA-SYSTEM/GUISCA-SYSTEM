  /* =========================================================
     19 · FACTURAS DE PROVEEDORES — lectura de PDF y fotos
     =====================================================================
     Cadena completa:
       1) Leer el archivo: PDF (texto real, sin librerías) o foto (OCR).
       2) Interpretar el texto: proveedor, fecha, número, total y renglones.
       3) Emparejar cada renglón con el catálogo (código, SKU o nombre).
       4) Mostrar el antes/después y aplicar: stock, costo, precio y compra.
     ===================================================================== */
  State.invoice = null;

  /* ---------- utilidades de números y texto ---------- */
  function parseNumLoose(s) {
    if (s === null || s === undefined) return 0;
    s = String(s).trim();
    if (!s) return 0;
    var hasC = s.indexOf(',') > -1, hasP = s.indexOf('.') > -1;
    if (hasC && hasP) {
      s = (s.lastIndexOf(',') > s.lastIndexOf('.')) ? s.replace(/\./g, '').replace(',', '.') : s.replace(/,/g, '');
    } else if (hasC) {
      s = /,\d{1,2}$/.test(s) ? s.replace(',', '.') : s.replace(/,/g, '');
    } else if (hasP) {
      /* "1.450" en Argentina son mil pesos; "1.5" es un decimal */
      s = /\.\d{3}(?!\d)/.test(s) ? s.replace(/\./g, '') : s;
    }
    var n = parseFloat(s);
    return isFinite(n) ? n : 0;
  }
  function stripAccents(s) {
    return String(s || '').replace(/[áàäâ]/g, 'a').replace(/[éèëê]/g, 'e').replace(/[íìïî]/g, 'i')
      .replace(/[óòöô]/g, 'o').replace(/[úùüû]/g, 'u').replace(/ñ/g, 'n').replace(/ç/g, 'c');
  }
  function normName(s) { return stripAccents(s).toLowerCase().replace(/[^a-z0-9]/g, ''); }
  function nameTokens(s) {
    return normName(s).replace(/(\d+)/g, ' $1 ').split(/\s+/).filter(function (t) { return t.length >= 2; });
  }
  function similarity(a, b) {
    var na = normName(a), nb = normName(b);
    if (!na || !nb) return 0;
    if (na === nb) return 1;
    if (na.length >= 5 && nb.length >= 5 && (na.indexOf(nb) >= 0 || nb.indexOf(na) >= 0)) return 0.92;
    var ta = nameTokens(a), tb = nameTokens(b), inter = 0;
    ta.forEach(function (t) { if (tb.indexOf(t) >= 0) inter++; });
    /* Dice: tolera que la factura acorte el nombre ("DETERGENTE 1LT" vs "DETERGENTE 1L")
       pero separa envases distintos ("COCA COLA 1.5L" vs "COCA COLA 2.25L") */
    return (2 * inter) / (ta.length + tb.length);
  }

  /** Busca el producto del catálogo que corresponde a un renglón. */
  function matchInvoiceProduct(desc, barcode) {
    var list = products(), i, p;
    if (barcode) {
      for (i = 0; i < list.length; i++) if (String(list[i].barcode || '') === String(barcode)) return list[i];
    }
    var n = normName(desc);
    if (!n) return null;
    for (i = 0; i < list.length; i++) if (normName(list[i].name) === n) return list[i];
    for (i = 0; i < list.length; i++) {
      var sku = normName(list[i].sku);
      if (sku && sku.length >= 4 && n.indexOf(sku) >= 0) return list[i];
    }
    var best = null;
    for (i = 0; i < list.length; i++) {
      var s = similarity(desc, list[i].name);
      if (!best || s > best.s) best = { p: list[i], s: s };
    }
    return (best && best.s >= 0.6) ? best.p : null;
  }


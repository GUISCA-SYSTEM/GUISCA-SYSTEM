    var horaPico = 0; for (var i = 1; i < 24; i++) if (byHour[i] > byHour[horaPico]) horaPico = i;

    var bySup = {};
    purchases().forEach(function (p) { var k = p.supplier || 'Sin proveedor'; bySup[k] = (bySup[k] || 0) + num(p.total); });
    var supArr = Object.keys(bySup).map(function (k) { return { nombre: k, comprado: bySup[k] }; })
      .sort(function (a, c) { return c.comprado - a.comprado; });

    var low = prods.filter(function (p) { return int(p.stock) > 0 && int(p.stock) <= int(p.minStock); });
    var out = prods.filter(function (p) { return int(p.stock) === 0; });
    var sinMov = prods.filter(function (p) { return !sold[p.id]; });
    var valorCosto = prods.reduce(function (s, p) { return s + num(p.cost) * int(p.stock); }, 0);
    var valorVenta = prods.reduce(function (s, p) { return s + num(p.price) * int(p.stock); }, 0);
    var bajoMargen = prods.filter(function (p) {
      return num(p.price) > 0 && (num(p.price) - num(p.cost)) / num(p.price) * 100 < 20 && int(p.stock) >= 0;
    });
    var sinMov = prods.filter(function (p) { return !sold[p.id]; });
    var alertas = (b.costAlerts || []).slice(-6).reverse();

    return {

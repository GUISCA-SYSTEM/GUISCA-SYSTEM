  function handleLogin() {
    if (loginBusy) return;
    var wait = loginLockUntil - Date.now();
    if (wait > 0) return loginMsg('Demasiados intentos. Esperá ' + Math.ceil(wait / 1000) + ' segundos.');
    var user = ($('loginUser').value || '').trim(), pass = $('loginPass').value || '';
    if (!user || pass.length < 3) return loginMsg();
    UI.hide('loginError');
    loginBusy = true;
    doLogin(user, pass).then(function (ok) {
      loginBusy = false;
      if (ok) { loginFails = 0; $('loginPass').value = ''; return; }
      loginFails++;
      if (loginFails >= 5) { loginFails = 0; loginLockUntil = Date.now() + 30000; loginMsg('Demasiados intentos. Esperá 30 segundos.'); }
      else loginMsg();
    }).catch(function (e) {
      loginBusy = false; reportError(e, 'login'); loginMsg('No se pudo iniciar sesión. Probá de nuevo.');
    });
  }
  /** Devuelve una promesa con true si entró. */
  function doLogin(user, pass) {
    var uq = user.toLowerCase(), sa = SuperAdmin.get();
    // 1) Super Admin: solo con su email y contraseña propios
    if (sa && sa.email === uq) {
      return Auth.verify(pass, sa).then(function (ok) {
        if (!ok) return false;
        superSession = true; openAdminScreen(); return true;
      });
    }
    // 2) Empleados: usuario y contraseña que les dio su dueño
    return findEmployee(user, pass).then(function (emp) {
      if (emp) { loginAsEmployee(emp); return true; }
      // 3) Dueños: email exacto + contraseña propia de cada negocio
      return findOwner(uq, pass).then(function (f) {
        if (!f) return false;
        State.business = f.business;
        State.user = { email: f.user.email, name: f.user.name, role: f.user.role || 'OWNER', businessId: f.business.id };
        f.user.lastLogin = new Date().toISOString();
        DB.save();
        enterApp();
        return true;
      });
    });
  }


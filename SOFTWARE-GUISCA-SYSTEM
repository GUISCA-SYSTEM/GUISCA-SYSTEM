  /* ---- Cierre de caja ---- */
  function openCloseCash() {
    var b = biz(); if (!b) return;
    renderCashClosing();
    UI.modal('closeCashModal', true);
  }
  function closeCloseCash() { UI.modal('closeCashModal', false); }
  function renderCashClosing() {
    var b = biz(); if (!b) return;
    var c = cashToday();
    var prev = cashClosings().filter(function (x) { return x.date !== dayKey(); })
      .sort(function (a, z) { return String(z.date).localeCompare(String(a.date)); })[0];
    $('ccOpening').value = String(Math.round(c.opening));
    $('ccExpected').textContent = fmtMoney(c.cashTotal);
    $('ccCounted').value = String(Math.round(c.cashTotal));
    var rows = [
      ['Fondo inicial de caja', fmtMoney(c.opening)],
      ['Ventas en efectivo (' + c.salesCount + ' op.)', fmtMoney(c.salesCash)],
      ['Ventas digitales (transferencias / billeteras)', fmtMoney(c.salesDigital)],
      ['Total vendido hoy', fmtMoney(c.salesTotal)],
      ['+ Ingresos en efectivo', fmtMoney(c.incCash)],
      ['+ Ingresos digitales', fmtMoney(c.incDigital)],
      ['− Gastos en efectivo', fmtMoney(c.expCash)],
      ['− Gastos digitales', fmtMoney(c.expDigital)],
      ['− Retiros de efectivo', fmtMoney(c.wdCash)],
      ['− Retiros digitales', fmtMoney(c.wdDigital)],
      ['Efectivo que debería haber en caja', fmtMoney(c.cashTotal)],
      ['Movimientos registrados hoy', String(c.count)],
      ['Resultado del día (ventas − gastos)', fmtMoney(c.result)]
    ];
    $('ccBreakdown').innerHTML = rows.map(function (r, i) {
      var strong = (i === 10 || i === 12);
      return '<div class="cc-row' + (strong ? ' cc-strong' : '') + '"><span>' + esc(r[0]) + '</span><b>' + esc(r[1]) + '</b></div>';
    }).join('');

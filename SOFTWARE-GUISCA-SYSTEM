/* =====================================================================
   MI NEGOCIO PRO — hoja de estilos
   Organización:
     01 · Tokens y paleta          06 · Tablas, tags y badges
     02 · Base y reset             07 · Gráficos
     03 · Layout                   08 · Componentes de color
     04 · Botones e inputs         09 · Lector de código de barras
     05 · Tarjetas y modales       10 · Navegación y utilidades
   ===================================================================== */

/* ---------- 01 · TOKENS Y PALETA ---------- */
:root {
  --primary: #2563eb; --primary-dark: #1d4ed8; --primary-soft: #eff6ff;
  --success: #10b981; --warn: #f59e0b; --danger: #ef4444;
  --bg: #f8fafc; --surface: #ffffff; --ink: #0f172a;
  --muted: #64748b; --border: #e2e8f0;
  --radius: 14px; --shadow: 0 1px 3px rgba(15,23,42,0.06), 0 6px 20px rgba(15,23,42,0.04);
  --shadow-lg: 0 12px 40px rgba(15,23,42,0.08);
  /* Paleta de color */
  --violet: #7c3aed; --violet-dark: #6d28d9; --violet-soft: #f5f3ff;
  --emerald: #059669; --emerald-soft: #ecfdf5;
  --amber: #d97706; --amber-soft: #fffbeb;
  --rose: #e11d48; --rose-soft: #fff1f2;
  --cyan: #0891b2; --cyan-soft: #ecfeff;
  --orange: #ea580c; --orange-soft: #fff7ed;
  --indigo: #4f46e5; --indigo-soft: #eef2ff;
  --teal: #0d9488; --teal-soft: #f0fdfa;
}
* { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
/* Los hijos de una grilla deben poder encogerse: sin esto cada tarjeta se
   desborda de su columna y se solapa con las de al lado. */
.grid > * { min-width: 0; }
.cat-grid > * { min-width: 0; }
html { scroll-behavior: smooth; }
body { font-family: 'Inter', system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif; background: var(--bg); color: var(--ink); -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; }
::selection { background: #bfdbfe; color: #0f172a; }
img { max-width: 100%; height: auto; display: block; }

/* ---------- 02 · BASE Y RESET ---------- */
/* Utilities */
.container-app { max-width: 1280px; margin: 0 auto; padding: 0 1.25rem; }
@media (min-width: 1024px) { .container-app { padding: 0 2rem; } }

/* ---------- 03 · LAYOUT ---------- */
/* Cards */
.card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow); transition: box-shadow .2s ease, transform .15s ease; }
.card:hover { box-shadow: var(--shadow-lg); }

/* ---------- 04 · BOTONES E INPUTS ---------- */
/* Inputs */
.input { width: 100%; padding: .55rem .75rem; border: 1.5px solid #e2e8f0; border-radius: 10px; font-size: .92rem; color: var(--ink); background: #fff; transition: border-color .15s, box-shadow .15s; font-family: inherit; }
.input:focus { border-color: #93c5fd; box-shadow: 0 0 0 3px rgba(37,99,235,.12); outline: none; }
/* Modals */
.modal-overlay { position: fixed; inset: 0; background: rgba(15,23,42,.55); backdrop-filter: blur(4px); z-index: 60; display: none; align-items: center; justify-content: center; padding: 1rem; opacity: 0; transition: opacity .2s ease; }
.modal-overlay.active { display: flex; opacity: 1; }
.modal-panel { background: #fff; border-radius: 18px; width: 100%; max-width: 560px; max-height: 90vh; overflow-y: auto; box-shadow: 0 25px 60px rgba(0,0,0,.25); transform: translateY(12px) scale(.98); transition: transform .25s cubic-bezier(.22,1,.36,1); }
.modal-overlay.active .modal-panel { transform: translateY(0) scale(1); }

/* ---------- 05 · TARJETAS Y MODALES ---------- */
/* Buttons */
.btn { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; padding: .6rem 1rem; border-radius: 10px; font-weight: 600; font-size: .9rem; border: none; cursor: pointer; transition: all .15s ease; letter-spacing: -.01em; }
.btn:active { transform: translateY(1px); }
.btn-primary { background: linear-gradient(135deg, #2563eb, #1d4ed8); color: #fff; box-shadow: 0 4px 14px rgba(37,99,235,.25); }
.btn-primary:hover { background: linear-gradient(135deg, #1d4ed8, #1e40af); box-shadow: 0 6px 20px rgba(37,99,235,.35); transform: translateY(-1px); }
.btn-secondary { background: #f1f5f9; color: #334155; border: 1px solid #e2e8f0; }
.btn-secondary:hover { background: #e2e8f0; }
.btn-ghost { background: transparent; color: #334155; }
.btn-ghost:hover { background: #f1f5f9; }
.btn-danger { background: #fef2f2; color: #991b1b; border: 1px solid #fecaca; }
.btn-danger:hover { background: #fee2e2; }
/* Nav */
.nav-item { display: flex; align-items: center; gap: .75rem; padding: .6rem .8rem; border-radius: 10px; color: #475569; font-weight: 500; font-size: .9rem; transition: all .12s; text-decoration: none; position: relative; }
.nav-item .nav-ico { width: 30px; height: 30px; border-radius: 9px; display: inline-flex; align-items: center; justify-content: center; font-size: .95rem; background: #f1f5f9; transition: all .15s; flex-shrink: 0; }
.nav-item:hover:not(.active) { background: #f8fafc; color: #0f172a; }
.nav-item.active { background: var(--nv-soft, #eff6ff); color: var(--nv-color, #1d4ed8); font-weight: 700; }
.nav-item.active .nav-ico { background: var(--nv-color, #2563eb); color: #fff; box-shadow: 0 4px 10px -3px var(--nv-color, #2563eb); }
.nv-blue { --nv-color: #2563eb; --nv-soft: #eff6ff; }
.nv-violet { --nv-color: #7c3aed; --nv-soft: #f5f3ff; }
.nv-emerald { --nv-color: #059669; --nv-soft: #ecfdf5; }
.nv-amber { --nv-color: #d97706; --nv-soft: #fffbeb; }
.nv-rose { --nv-color: #e11d48; --nv-soft: #fff1f2; }
.nv-cyan { --nv-color: #0891b2; --nv-soft: #ecfeff; }
.nv-orange { --nv-color: #ea580c; --nv-soft: #fff7ed; }
.nv-indigo { --nv-color: #4f46e5; --nv-soft: #eef2ff; }

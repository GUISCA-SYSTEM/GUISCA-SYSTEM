  /* =========================================================
     15 · TIEMPO REAL — sesiones vivas y datos sincronizados
     ========================================================= */
  function roleLabel(id) {
    if (id === 'OWNER') return 'Dueño';
    if (id === 'SUPER_ADMIN') return 'Administrador';
    var r = roleInfo(id);
    return r ? r.name : 'Empleado';
  }

  var Realtime = {
    NAME: 'mn_live_v1',
    tab: 't' + Date.now().toString(36) + Math.random().toString(36).slice(2, 5),
    chan: null, peers: {}, hb: null, clock: null, lastApply: 0, lastToast: 0, pending: null, lastSales: -1,

    init: function () {
      var self = this;
      try {
        if (typeof BroadcastChannel !== 'undefined') {
          this.chan = new BroadcastChannel(this.NAME);
          this.chan.onmessage = function (ev) { self.recv(ev && ev.data); };
        }
      } catch (e) { this.chan = null; }

      /* Respaldo para navegadores sin BroadcastChannel (Safari viejo) */
      window.addEventListener('storage', function (e) {
        if (!e.key) return;
        if (e.key === DB.KEY) self.applyRemote('otra sesión');
        else if (e.key === 'mn_platform') {
          updateNavBadges();
          if (State.view === 'employees') renderEmployees();
        }
      });

      if (this.hb) clearInterval(this.hb);
      this.hb = setInterval(function () { self.ping(); }, 4000);
      if (this.clock) clearInterval(this.clock);
      this.clock = setInterval(function () { self.tick(); }, 1000);
      window.addEventListener('pagehide', function () { self.say({ t: 'bye', from: self.tab }); });
      this.ping();
      this.tick();
    },

    say: function (msg) {
      if (!this.chan) return;
      try { this.chan.postMessage(msg); } catch (e) { /* canal cerrado */ }
    },
    /** Avisa a las demás sesiones que algo cambió ('data' o 'flags'). */
    push: function (kind) { this.say({ t: kind || 'data', from: this.tab, at: Date.now() }); },

    me: function () {
      return {
        from: this.tab, t: 'ping',
        name: (State.user && State.user.name) || 'Usuario',
        role: (State.user && State.user.role) || 'OWNER',
        view: State.view || 'dashboard',
        businessId: State.business && State.business.id,
        at: Date.now()
      };
    },
    ping: function () {
      var m = this.me();
      this.peers[this.tab] = m;
      this.say(m);
      this.prune();
      this.paint();
    },
    prune: function () {
      var now = Date.now(), self = this;
      Object.keys(this.peers).forEach(function (k) {
        if (k !== self.tab && now - num(self.peers[k].at) > 13000) delete self.peers[k];
      });
    },
    /** Sesiones vivas del negocio activo (incluye la propia). */
    online: function () {
      this.prune();
      var self = this, bid = State.business && State.business.id;
      return Object.keys(this.peers).map(function (k) {
        var p = self.peers[k];
        return { name: p.name, role: p.role, view: p.view, self: k === self.tab, businessId: p.businessId };
      }).filter(function (p) { return !bid || !p.businessId || p.businessId === bid; });
    },
    recv: function (msg) {
      if (!msg || msg.from === this.tab) return;
      if (msg.t === 'ping') { this.peers[msg.from] = msg; this.paint(); }
      else if (msg.t === 'bye') { delete this.peers[msg.from]; this.paint(); }
      else if (msg.t === 'data') this.applyRemote('otra sesión');
      else if (msg.t === 'flags') {
        updateNavBadges();
        if (State.view === 'employees') safe(renderEmployees, 'refresco de permisos');
      }
    },

    /** Relee los datos del almacenamiento y refresca la interfaz. */
    applyRemote: function (who) {
      var now = Date.now(), self = this;
      var wait = 250 - (now - this.lastApply);         // anti-rebote…
      if (wait > 0) {                                  // …pero sin perder ningún aviso
        if (this.pending) clearTimeout(this.pending);
        this.pending = setTimeout(function () { self.pending = null; self.applyRemote(who); }, wait);
        return;
      }
      this.lastApply = now;
      var id = State.business && State.business.id;
      DB.load();
      var found = null;
      for (var i = 0; i < State.businesses.length; i++) {
        if (State.businesses[i].id === id) { found = State.businesses[i]; break; }
      }
      if (!found) return;
      State.business = found;                           // el objeto anterior quedó descolgado
      updateNavBadges();
      if (typeof renderLivePanels === 'function') renderLivePanels();
      var busy = $$('.modal-overlay.active').length > 0 || State.saving;
      if (!busy) {
        if (State.view === 'dashboard') safe(renderDashboard, 'refresco en vivo');
        else if (State.view === 'employees') safe(renderEmployees, 'refresco en vivo');
        else if (State.view === 'sales') safe(renderSales, 'refresco en vivo');
      }
      if (now - this.lastToast > 8000) {
        this.lastToast = now;
        UI.toast('🔄 Ventas actualizadas en vivo (' + (who || 'otra sesión') + ')', 'info', 2200);
      }
    },

    paint: function () {
      var n = String(this.online().length);
      var el = $('liveCount');
      if (el) el.textContent = n;
      var badge = $('liveCountBadge');
      if (badge) badge.textContent = n;
      var pill = $('livePill');
      if (pill) pill.classList.add('on');
      /* el panel "en vivo" se redibuja si cambió la cantidad de ventas */
      var n = sales().length;
      if (n !== this.lastSales) {
        this.lastSales = n;
        if ((State.view === 'dashboard' || State.view === 'employees') && typeof renderLivePanels === 'function') {
          renderLivePanels();
        }
      }
    },
    tick: function () {
      var c = $('liveClock');
      if (c) {
        var d = new Date();
        c.textContent = String(d.getHours()).padStart(2, '0') + ':' +
          String(d.getMinutes()).padStart(2, '0') + ':' + String(d.getSeconds()).padStart(2, '0');
      }
      this.paint();
    }
  };

  /** Panel “en vivo”: quién está conectado y últimas ventas. */
  function renderLivePanels() {
    var sessions = $('liveSessions');
    if (sessions) {
      var list = (typeof Realtime !== 'undefined' && Realtime.online) ? Realtime.online() : [];
      sessions.innerHTML = list.length ? list.map(function (p) {
        return '<div class="live-row"><span class="live-dot"></span>' +
          '<div class="min-w-0 flex-1"><div class="font-bold text-sm truncate">' + esc(p.name) + (p.self ? ' (esta sesión)' : '') + '</div>' +
          '<div class="text-[11px] text-slate-400">' + esc(roleLabel(p.role)) + ' · viendo ' + esc(p.view) + '</div></div>' +
          '<span class="tag tag-green">en línea</span></div>';
      }).join('') : '<div class="text-sm text-slate-400 py-3 text-center">Sin sesiones activas</div>';
    }
    var feed = $('liveFeed');
    if (feed) {
      var recent = sales().slice().sort(function (a, c) {
        var da = parseDate(a.date), dc = parseDate(c.date);
        return (dc ? dc.getTime() : 0) - (da ? da.getTime() : 0);
      }).slice(0, 7);
      feed.innerHTML = recent.length ? recent.map(function (s) {
        var d = parseDate(s.date);
        return '<div class="feed-row"><div class="feed-ico">🧾</div>' +
          '<div class="min-w-0 flex-1"><div class="font-bold text-sm">' + fmtMoney(s.total) + '</div>' +
          '<div class="text-[11px] text-slate-400 truncate">' + esc(s.user || 'Sistema') + ' · ' + ((s.items || []).length) + ' items · ' + esc(s.payment || '—') + '</div></div>' +
          '<div class="text-[11px] font-mono text-slate-400 whitespace-nowrap">' +
          (d ? d.toLocaleTimeString('es-AR', { hour: '2-digit', minute: '2-digit' }) : '—') + '</div></div>';
      }).join('') : '<div class="text-sm text-slate-400 py-3 text-center">Todavía no hay ventas</div>';
    }
  }

  /* =========================================================
     17 · CAJA — efectivo y transferencias del día, cierre desglosado
     =====================================================================
     Cada venta, gasto, ingreso o retiro queda registrado como
     movimiento de caja con su método (EFECTIVO / DIGITAL), así el
     dueño ve separado lo que entró por efectivo de lo que entró por
     transferencia o billetera virtual.
     ===================================================================== */
  function cashList() { var b = biz(); if (!b) return []; b.cashMovements = b.cashMovements || []; return b.cashMovements; }
  function cashClosings() { var b = biz(); if (!b) return []; b.cashClosings = b.cashClosings || []; return b.cashClosings; }

  /**
   * Completa los campos nuevos (negocios creados con versiones anteriores)
   * y da de alta en la caja de hoy las ventas que aún no tengan movimiento.
   * Es idempotente: se puede llamar en cada render sin duplicar nada.
   */
  function ensureCashLedger() {
    var b = biz(); if (!b) return;
    if (!b.cashMovements) b.cashMovements = [];
    if (!b.cashClosings) b.cashClosings = [];
    if (b.settings.cashOpening === undefined) b.settings.cashOpening = 0;
    var today = dayKey();
    var have = {};
    b.cashMovements.forEach(function (m) { if (m.refId) have[m.refId] = true; });
    var added = false;
    sales().forEach(function (s) {
      if (dayKey(s.date) !== today || have[s.id]) return;
      have[s.id] = true; added = true;
      b.cashMovements.push({
        id: uid('cm'), type: 'VENTA', amount: num(s.total),
        method: s.payment === 'Efectivo' ? 'EFECTIVO' : 'DIGITAL',
        note: 'Venta #' + s.id, user: s.user || 'Sistema', userId: s.userId || '',
        refId: s.id, date: s.date
      });
    });
    if (added) DB.save();
  }

  /** Resumen de caja del día, con efectivo y digital por separado. */
  function cashToday() {
    var today = dayKey();
    var list = cashList().filter(function (m) { return dayKey(m.date) === today; });
    var o = {
      salesCash: 0, salesDigital: 0, expCash: 0, expDigital: 0, incCash: 0, incDigital: 0,
      wdCash: 0, wdDigital: 0, count: list.length, salesCount: 0, list: list
    };
    list.forEach(function (m) {
      var a = num(m.amount), dig = m.method === 'DIGITAL';
      if (m.type === 'VENTA') { if (dig) o.salesDigital += a; else o.salesCash += a; o.salesCount++; }
      else if (m.type === 'GASTO') { if (dig) o.expDigital += a; else o.expCash += a; }
      else if (m.type === 'INGRESO') { if (dig) o.incDigital += a; else o.incCash += a; }
      else if (m.type === 'RETIRO') { if (dig) o.wdDigital += a; else o.wdCash += a; }
    });
    o.cashNet = o.salesCash + o.incCash - o.expCash - o.wdCash;
    o.digitalNet = o.salesDigital + o.incDigital - o.expDigital - o.wdDigital;
    o.salesTotal = o.salesCash + o.salesDigital;
    o.expTotal = o.expCash + o.expDigital;
    o.incTotal = o.incCash + o.incDigital;
    o.wdTotal = o.wdCash + o.wdDigital;
    o.result = o.salesTotal - o.expTotal;
    o.opening = num(settings().cashOpening);
    o.cashTotal = o.opening + o.cashNet;
    return o;
  }

  function renderCashPanel() {
    var b = biz(); if (!b) return;
    ensureCashLedger();
    var c = cashToday();
    var set = function (id, v) { var el = $(id); if (el) el.textContent = String(v); };
    set('cashCashToday', fmtMoney(c.cashNet));
    set('cashDigitalToday', fmtMoney(c.digitalNet));
    set('cashTotal', fmtMoney(c.cashTotal));
    set('cashSales', fmtMoney(c.salesTotal));
    set('cashExpenses', fmtMoney(c.expTotal));
    set('cashIncome', fmtMoney(c.incTotal));
    set('cashWithdraw', fmtMoney(c.wdTotal));
    set('cashResult', fmtMoney(c.result));
    set('cashSalesSub', c.salesCount + (c.salesCount === 1 ? ' venta hoy' : ' ventas hoy'));
    set('cashExpensesSub', c.count + (c.count === 1 ? ' movimiento' : ' movimientos'));
    set('cashIncomeSub', 'Ingresos del día');
    set('cashWithdrawSub', 'Retiros del día');
    set('cashTotalSub', 'Apertura ' + fmtMoney(c.opening));
    set('cashCashSub', 'Ventas ' + fmtMoney(c.salesCash) + ' · Neto');
    set('cashDigitalSub', 'Ventas ' + fmtMoney(c.salesDigital) + ' · Neto');
    set('cashResultSub', 'Ventas ' + fmtMoney(c.salesTotal) + ' − Gastos ' + fmtMoney(c.expTotal));
    var st = $('cashStatus');
    if (st) {
      var close = cashClosings().filter(function (x) { return x.date === dayKey(); })[0];
      st.innerHTML = close
        ? '<span class="perm-chip ok">🔒 Cierre ' + (close.auto ? 'automático' : 'manual') + ' a las ' +
          (parseDate(close.closedAt) ? parseDate(close.closedAt).toLocaleTimeString('es-AR', { hour: '2-digit', minute: '2-digit' }) : '—') + '</span>'
        : '<span class="perm-chip ok">🟢 Caja abierta · cierre automático ' + esc(settings().closeTime || '21:00') + '</span>';
    }
  }


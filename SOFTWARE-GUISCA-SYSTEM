        '<td class="font-mono font-bold">' + int(m.after) + '</td>' +
        '<td class="text-xs text-slate-500">' + esc(m.user) + '</td></tr>';
    }).join('') : '<tr><td colspan="7" class="text-center text-slate-400 py-6">Sin movimientos registrados</td></tr>';

    /* ---- Datos del reporte (para exportar a PDF) ---- */
    State.report = {
      range: rangeLabel,
      revenue: sum.revenue, units: sum.units, tickets: sum.tickets, avgTicket: sum.avgTicket,
      gross: sum.gross, grossPct: sum.grossPct, cogs: sum.cogs, netoVentas: netoVentas, ivaDebito: ivaDebito,
      ivaCredito: ivaCredito, ivaPagar: Math.max(0, ivaDebito - ivaCredito), totalCompras: totalBuys,
      costValue: costValue, saleValue: saleValue, avgMargin: avgMargin,
      lowCount: low.length, outCount: out.length, overCount: over.length,
      top: top, catEntries: catEntries, payEntries: payEntries,
      buckets: buckets, hourBuckets: byHour,
      bySupplier: Object.keys(bySupplier).map(function (k) { return { name: k, value: bySupplier[k] }; }),
      dead: dead, critical: critical, movements: movs,
      insights: insights.map(function (x) { return String(x.m).replace(/<[^>]*>/g, ''); })

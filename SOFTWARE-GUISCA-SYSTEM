/* Nav inferior móvil */
.bn-item { display: flex; flex-direction: column; align-items: center; gap: .1rem; padding: .45rem .25rem; font-size: .68rem; font-weight: 700; color: #94a3b8; transition: all .15s; position: relative; text-decoration: none; }

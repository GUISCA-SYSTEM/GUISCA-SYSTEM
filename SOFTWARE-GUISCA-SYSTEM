  function addToCartFromScan(keepScanning) {
    var p = State.lastScan;
    if (!p) return UI.toast('No hay producto escaneado', 'warn');
    var existing = State.cart.filter(function (c) { return c.id === p.id; })[0];
    if (existing) existing.qty += 1;
    else State.cart.push({ id: p.id, name: p.name, barcode: p.barcode, price: num(p.price), qty: 1 });
    updateCartUI();
    if (keepScanning) {
      UI.hide('scanResultPanel'); UI.hide('scanNotFound');
      setScanStatus('Escaneando… apuntá al código', 'live');
      UI.toast('✅ ' + p.name + ' — seguí escaneando', 'ok');

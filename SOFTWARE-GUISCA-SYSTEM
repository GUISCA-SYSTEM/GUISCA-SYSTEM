  /* --- Renderizadores reutilizables de gráficos --- */
  function renderVBars(id, buckets) {
    var el = $(id); if (!el) return;
    var max = Math.max.apply(null, [1].concat(buckets.map(function (x) { return x.value; })));
    el.innerHTML = buckets.map(function (x, i) {
      var c = CHART_COLORS[i % CHART_COLORS.length];
      return '<div class="vcol"><div class="vbar" style="height:' + Math.max(3, (x.value / max) * 100) + '%;--bc:' + c[0] + ';--bc2:' + c[1] +
        '" data-val="' + fmtCompact(x.value) + '"></div><div class="vlab">' + esc(x.label) + '</div></div>';
    }).join('');
  }
  function renderBars(id, entries, emptyMsg) {
    var el = $(id); if (!el) return;
    if (!entries.length) { el.innerHTML = '<div class="text-sm text-slate-400">' + esc(emptyMsg || 'Sin datos') + '</div>'; return; }
    var max = Math.max.apply(null, entries.map(function (x) { return x.value; }));
    el.innerHTML = entries.map(function (x, i) {
      var c = CHART_COLORS[i % CHART_COLORS.length];
      return '<div class="bar-row"><div class="bar-label">' + esc(x.name) + '</div>' +
        '<div class="bar-track"><div class="bar-fill" style="width:' + (x.value / max * 100) + '%;--bf:' + c[0] + ';--bf2:' + c[1] + '"></div></div>' +
        '<div class="bar-val">' + fmtCompact(x.value) + '</div></div>';
    }).join('');
  }
  function renderDonut(id, entries) {
    var el = $(id); if (!el) return;
    var total = entries.reduce(function (s, x) { return s + x.value; }, 0);
    if (!total) { el.innerHTML = '<div class="text-sm text-slate-400">Sin ventas para graficar</div>'; return; }
    var acc = 0;
    var stops = entries.map(function (x, i) {
      var col = categoryColor(x.name, i), from = acc / total * 100; acc += x.value;
      return col + ' ' + from + '% ' + (acc / total * 100) + '%';
    }).join(', ');
    el.innerHTML = '<div class="donut-wrap"><div class="donut" style="background: conic-gradient(' + stops + ')">' +
      '<div class="donut-center"><b>' + fmtCompact(total) + '</b><small>Total</small></div></div><div class="legend">' +
      entries.map(function (x, i) {
        return '<div class="legend-item"><span class="dot" style="background:' + categoryColor(x.name, i) + '"></span>' +
          '<span class="lg-name">' + esc(x.name) + '</span><span class="lg-val">' + Math.round(x.value / total * 100) + '%</span></div>';
      }).join('') + '</div></div>';
  }

  /* --- Exportación --- */
  function exportReport(fmt) {
    var rep = State.report;
    if (fmt === 'csv' && rep) {
      try {
        var rows = [
          ['Reporte del negocio', rep.range], [],
          ['Métrica', 'Valor'],
          ['Facturación', Math.round(rep.revenue)],
          ['Operaciones', rep.tickets],
          ['Unidades vendidas', rep.units],
          ['Ticket promedio', Math.round(rep.avgTicket)],
          ['Costo de mercadería vendida', Math.round(rep.cogs)],
          ['Margen bruto', Math.round(rep.gross)],
          ['Margen %', rep.grossPct.toFixed(1)],
          ['Ventas netas (sin IVA)', Math.round(rep.netoVentas)],
          ['IVA débito fiscal', Math.round(rep.ivaDebito)],
          ['IVA crédito fiscal', Math.round(rep.ivaCredito)],
          ['IVA a pagar estimado', Math.round(rep.ivaPagar)],
          ['Compras del período', Math.round(rep.totalCompras)],
          ['Valor de stock (costo)', Math.round(rep.costValue)],
          ['Valor de stock (venta)', Math.round(rep.saleValue)], [],
          ['Categoría', 'Facturación']
        ].concat(rep.catEntries.map(function (c) { return [c.name, Math.round(c.value)]; }))
          .concat([[], ['Medio de pago', 'Facturación']])
          .concat(rep.payEntries.map(function (p) { return [p.name, Math.round(p.value)]; }))
          .concat([[], ['Producto', 'Unidades', 'Facturación']])
          .concat(rep.top.map(function (t) { return [t.p ? t.p.name : '-', t.qty, Math.round(t.rev)]; }));
        var csv = rows.map(function (r) { return r.join(';'); }).join('\n');
        var blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
        var a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = 'reporte-negocio-' + dayKey() + '.csv';
        document.body.appendChild(a); a.click(); document.body.removeChild(a);
        UI.toast('CSV descargado con las métricas del período', 'ok');
      } catch (e) { reportError(e, 'exportar CSV'); }
      return;
    }
    if (fmt === 'ia') { UI.toast('Análisis IA: revisá el panel "Insights automáticos".', 'info', 4000); return; }
    if (fmt === 'pdf') { exportReportPdf(); return; }
    UI.toast('Exportando reporte en formato ' + String(fmt).toUpperCase() + '…', 'info');
  }


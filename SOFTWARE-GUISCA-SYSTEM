  /** Punto de entrada: decide si es PDF o imagen. */
  function handleInvoiceFile(input) {
    var file = input && input.files && input.files[0];
    if (!file) return;
    var looksPdf = /pdf/i.test(file.type) || /\.pdf$/i.test(file.name);
    var looksImg = /^image\//i.test(file.type) || /\.(jpe?g|png|webp|bmp|gif|heic)$/i.test(file.name);
    if (looksPdf) { readInvoicePdf(file); return; }
    if (looksImg) { readInvoiceImage(file); return; }
    if (file.slice && file.slice(0, 5).text) {           // miramos los primeros bytes
      file.slice(0, 5).text().then(function (magic) {
        if (String(magic).indexOf('%PDF') === 0) readInvoicePdf(file);
        else invError('Formato no reconocido. Usá un PDF o una foto (JPG/PNG).');
      }).catch(function () { invError('No se pudo leer el archivo.'); });
      return;
    }
    invError('Formato no reconocido. Usá un PDF o una foto (JPG/PNG).');
  }

  function readInvoicePdf(file) {
    invProgress(15, 'Leyendo el PDF…');
    var fr = new FileReader();
    fr.onerror = function () { invError('No se pudo abrir el archivo.'); };
    fr.onload = function () {
      invProgress(45, 'Extrayendo el texto…');
      safe(function () {
        Promise.resolve(extractPdfText(fr.result)).then(function (text) {
          if (!text || text.replace(/\s/g, '').length < 20) {
            invError('Este PDF no tiene texto seleccionable (es un escaneo). Sacale una foto o usá "Pegar texto".');
            return;
          }
          invProgress(85, 'Interpretando la factura…');
          processInvoiceText(text, file.name);
        }).catch(function (e) {
          reportError(e, 'extraer texto del PDF');
          invError('No se pudo leer el PDF. Puede estar dañado o protegido.');
        });
      }, 'leer PDF de factura');
    };
    fr.readAsArrayBuffer(file);
  }

  function readInvoiceImage(file) {
    invProgress(5, 'Preparando el lector de imágenes…');
    loadOcrEngine(function (err) {
      if (err) { invError('No se pudo bajar el lector de OCR (' + err.message + '). Usá "Pegar texto".'); return; }
      invProgress(20, 'Reconociendo el texto de la foto…');
      if (!window.Tesseract || typeof window.Tesseract.recognize !== 'function') {
        invError('El lector de OCR no está disponible. Revisá tu conexión o usá "Pegar texto".');
        return;
      }
      var prom;
      try {
        prom = window.Tesseract.recognize(file, 'spa', {
          logger: function (m) {
            if (m && typeof m.progress === 'number') {
              invProgress(20 + m.progress * 65, 'Leyendo la foto… ' + Math.round(m.progress * 100) + '%');
            }
          }
        });
      } catch (e) {
        invError('No se pudo iniciar el OCR (' + (e && e.message ? e.message : 'error') + '). Usá "Pegar texto".');
        return;
      }
      safe(function () {
        prom.then(function (res) {
          var text = res && res.data ? res.data.text : '';
          if (!text || text.replace(/\s/g, '').length < 20) {
            invError('No se encontró texto claro en la foto. Probá con más luz o usá "Pegar texto".');
            return;
          }
          invProgress(90, 'Interpretando la factura…');
          processInvoiceText(text, file.name);
        }).catch(function (e) {
          invError('Falló el reconocimiento: ' + (e && e.message ? e.message : 'error') + '. Usá "Pegar texto".');
        });
      }, 'OCR de factura');
    });
  }

  /** Carga Tesseract.js sólo cuando se necesita (no pesa al abrir la app). */
  function loadOcrEngine(cb) {
    if (window.Tesseract) { cb(null); return; }
    if (window.__ocrLoading) { window.__ocrLoading.push(cb); return; }
    window.__ocrLoading = [cb];
    var avisado = false;
    var avisar = function (err) {
      if (avisado) return;
      avisado = true;
      var q = window.__ocrLoading || []; window.__ocrLoading = null;
      q.forEach(function (f) { f(err); });
    };
    var s = document.createElement('script');
    s.src = 'https://cdn.jsdelivr.net/npm/tesseract.js@5.1.1/dist/tesseract.min.js';
    s.onload = function () { avisar(window.Tesseract ? null : new Error('el lector no cargó')); };
    s.onerror = function () { avisar(new Error('sin conexión')); };
    document.head.appendChild(s);
  }

  /* ---------- extracción de texto de un PDF (sin librerías) ---------- */
  function pdfUnescape(s) {
    return String(s).replace(/\\([nrtbf()\\]|[0-7]{1,3})/g, function (m, c) {
      if (c === 'n') return '\n';
      if (c === 'r') return '\r';
      if (c === 't') return '\t';
      if (c === 'b' || c === 'f') return '';
      if (/^[0-7]{1,3}$/.test(c)) return String.fromCharCode(parseInt(c, 8));
      return c;
    });
  }
  function bytesToStr(b) { var t = ''; for (var i = 0; i < b.length; i++) t += String.fromCharCode(b[i]); return t; }
  function inflatePdf(bytes) {
    if (typeof DecompressionStream === 'undefined') return null;
    try {
      var cs = new Blob([bytes]).stream();
      if (!cs || !cs.pipeThrough) return null;
      return new Response(cs.pipeThrough(new DecompressionStream('deflate'))).arrayBuffer();
    } catch (e) { return null; }
  }
  /** Convierte el flujo de contenido de una página en líneas de texto. */
  function pdfContentToLines(cs) {
    var lines = [], line = null, stack = [];
    var re = /(\((?:\\.|[^\\()])*\)|\[(?:[^\[\]]|\\.)*\]|-?\d*\.?\d+|[A-Za-z'"*]{1,3})/g, m;
    while ((m = re.exec(cs)) !== null) {
      var tok = m[0];
      if (tok === 'Tj' || tok === 'TJ' || tok === "'" || tok === '"') {
        var text = '';
        stack.forEach(function (t) {
          if (t.charAt(0) === '(') text += pdfUnescape(t.slice(1, -1));
          else if (t.charAt(0) === '[') {
            var r2 = /\((?:\\.|[^\\()])*\)|-?\d+(?:\.\d+)?/g, mm;
            while ((mm = r2.exec(t)) !== null) {
              if (mm[0].charAt(0) === '(') text += pdfUnescape(mm[0].slice(1, -1));
              else if (parseFloat(mm[0]) <= -140) text += ' ';   // kernging grande = espacio
            }
          }
        });
        if (line === null) line = '';
        line += text;
        stack = [];
      } else if (tok === 'Td' || tok === 'TD' || tok === 'T*' || tok === 'Tm' || tok === 'BT' || tok === 'ET') {
        if (line !== null && line.trim()) { lines.push(line.replace(/\s+/g, ' ').trim()); line = null; }
        stack = [];
      } else {
        stack.push(tok);
        if (stack.length > 6) stack.shift();
      }
    }
    if (line !== null && line.trim()) lines.push(line.replace(/\s+/g, ' ').trim());
    return lines;
  }
  /** Lee todos los flujos del PDF y devuelve una promesa con el texto. */
  function extractPdfText(buf) {
    var raw = new Uint8Array(buf || []);
    var all = bytesToStr(raw);
    var jobs = [], objRe = /(\d+)\s+(\d+)\s+obj\b([\s\S]*?)endobj/g, m;
    while ((m = objRe.exec(all)) !== null) {
      var body = m[3], si = body.indexOf('stream');
      if (si < 0) continue;
      var after = body.charAt(si + 6);
      if (after !== '\r' && after !== '\n') continue;             // "stream" dentro de un nombre
      var eol = body.slice(si + 6).search(/\r\n|\n|\r/);
      var dataStart = si + 6 + (eol < 0 ? 0 : eol + 1);
      var end = body.lastIndexOf('endstream');
      if (end < 0 || end <= dataStart) continue;
      var chunk = body.slice(dataStart, end).replace(/[\r\n]+$/, '');
      var bytes = new Uint8Array(chunk.length);
      for (var k = 0; k < chunk.length; k++) bytes[k] = chunk.charCodeAt(k) & 0xFF;
      jobs.push({ bytes: bytes, flate: /\/FlateDecode/.test(body.slice(0, si)) });
    }
    var textos = [];
    function push(t) { if (/BT|Tj|TJ/.test(t)) pdfContentToLines(t).forEach(function (l) { textos.push(l); }); }
    var chain = Promise.resolve();
    jobs.forEach(function (j) {
      chain = chain.then(function () {
        if (!j.flate) { push(bytesToStr(j.bytes)); return null; }
        var p = inflatePdf(j.bytes);
        return p ? p.then(function (ab) { push(bytesToStr(new Uint8Array(ab))); }) : null;
      });
    });
    return chain.then(function () { return textos.join('\n'); });
  }

  /* ---------- 3) interpretación del texto ---------- */
  var INV_SKIP = /(sub\s*total|subtotal|total|iva|i\.v\.a|percep|reten|descuent|descto|neto|importe\s+total|total\s+a\s*pagar|factura|comprobante|ticket|recibo|remito|presupuesto|av\.|avda|avenida|\bcalle\b|direccion|bulevar|localidad|provincia|telefono|\btel\b|www\.|http|original|duplicado|triplicado|pagina|pag\.|fecha|cae|cot|codigo\s+de\s+barras|razon\s+social|domicilio|condicion|cuit|ingresos\s+brutos|responsable|origen|destino|forma\s+de\s+pago|vencimiento|numero\s+de\s+comprobante|gracias|vuelto|su\s+vuelto|cambio|abona|saldo)/i;

  function findNumbers(line) {
    var out = [], re = /\d{1,3}(?:\.\d{3})+(?:,\d{1,2})?|\d+(?:[.,]\d+)?/g, m;
    while ((m = re.exec(line)) !== null) out.push({ v: parseNumLoose(m[0]), i: m.index, len: m[0].length });
    return out;
  }

  /** Detecta los renglones de productos de una factura en texto. */
  function detectInvoiceItems(lines) {
    var items = [];
    lines.forEach(function (line) {
      var clean = line.replace(/\s+/g, ' ').trim();
      if (clean.length < 5 || INV_SKIP.test(clean)) return;
      var nums = findNumbers(clean);
      if (nums.length < 2) return;
      var hit = null, i, mxHit = null;

      /* a) "10 x 1380" o "10 u. x $1.380": se usa sólo si no aparece una terna
            cantidad·precio·total, porque un "2x1" de promo no es un renglón */
      var mx = clean.match(/(\d+(?:[.,]\d+)?)\s*(?:u\.?|un\.?|unid\.?|uds\.?|kg|gr|lt)?\s*[x×]\s*\$?\s*(\d{1,3}(?:[.,]\d{3})+|\d+(?:[.,]\d{1,2})?)/i);
      if (mx) {
        var q = parseNumLoose(mx[1]), c = parseNumLoose(mx[2]);
        if (q > 0 && q <= 5000 && c > 0 && c < 5000000) mxHit = { qty: q, cost: c, total: q * c, from: mx.index };
      }
      /* b) terna cantidad · precio · total (en cualquier posición) */
      if (!hit) {
        var firstHit = null;
        for (i = 0; i + 2 < nums.length + 1; i++) {
          var a = nums[i], b = nums[i + 1], c2 = nums[i + 2];
          if (!a || !b || !c2) break;
          if (a.v > 0 && a.v <= 5000 && b.v > 0 && b.v < 5000000 && c2.v > 0 &&
              Math.abs(a.v * b.v - c2.v) <= Math.max(0.5, c2.v * 0.02)) {
            var h = { qty: a.v, cost: b.v, total: c2.v, from: a.i };
            if (!firstHit) firstHit = h;
            /* una cantidad fraccionaria casi siempre viene de la descripción ("1.5L") */
            if (a.v === Math.round(a.v)) { hit = h; break; }
          }
        }
        if (!hit) hit = firstHit;
      }
      if (!hit) hit = mxHit;
      /* c) dos números: cantidad y precio */
      if (!hit && nums.length === 2 && nums[0].v > 0 && nums[0].v <= 5000 &&
          nums[1].v > 0 && nums[1].v < 5000000 &&
          /^[\s$]*$/.test(clean.slice(nums[0].i + nums[0].len, nums[1].i))) {
        hit = { qty: nums[0].v, cost: nums[1].v, total: nums[0].v * nums[1].v, from: nums[0].i };
      }
      /* d) los dos últimos números, pegados: "DETERGENTE 1L  10  890" */
      if (!hit && nums.length >= 3) {
        var u = nums[nums.length - 2], w = nums[nums.length - 1];
        var entre = clean.slice(u.i + u.len, w.i);
        if (u.v > 0 && u.v <= 5000 && w.v > 0 && w.v < 5000000 && /^[\s$]*$/.test(entre)) {
          hit = { qty: u.v, cost: w.v, total: u.v * w.v, from: u.i };
        }
      }
      if (!hit) return;

      var desc = clean.slice(0, hit.from).replace(/[\s\-\|·:;,.*]+$/, '').trim();
      var code = (desc.match(/\b\d{8,14}\b/) || [''])[0];
      if (code) desc = desc.replace(code, ' ').replace(/\s{2,}/g, ' ').trim();
      if (desc.length < 3) return;
      var qty = (hit.qty === Math.round(hit.qty)) ? Math.round(hit.qty) : Math.round(hit.qty * 100) / 100;
      items.push({ desc: desc, barcode: code, qty: qty, cost: Math.round(hit.cost * 100) / 100, total: Math.round(hit.total * 100) / 100 });
    });
    return items;
  }

  /**
   * Los PDF suelen escribir cada columna con su propio Td, así que un renglón
   * de la factura llega partido en varias líneas ("COCA COLA" / "10" / "1380").
   * Acá volvemos a pegarlas: una línea con letras abre renglón y las que sólo
   * tienen números se le suman (hasta 4).
   */
  function mergeInvoiceRows(lines) {
    var out = [], cur = null, nums = 0;
    lines.forEach(function (l) {
      var t = String(l || '').replace(/\s+/g, ' ').trim();
      if (!t) return;
      if (/[a-zA-ZÀ-ÿ]{2}/.test(t)) {          // tiene texto → nuevo renglón
        if (cur) out.push(cur);
        cur = t; nums = 0;
      } else if (cur && nums < 4) {            // sólo números → columna del actual
        cur += ' ' + t; nums++;
      } else {
        if (cur) out.push(cur);
        cur = t; nums = 1;
      }
    });
    if (cur) out.push(cur);
    return out;
  }

  /** "12/09/2026", "12-09-26" o "12.09.2026" → "2026-09-12" (lo que usa <input type="date>). */
  function invISO(d) {
    var m = String(d || '').match(/^(\d{1,2})[-/.](\d{1,2})[-/.](\d{2,4})$/);
    if (!m) return '';
    var y = parseInt(m[3], 10);
    if (y < 100) y += y > 70 ? 1900 : 2000;
    return y + '-' + ('0' + parseInt(m[2], 10)).slice(-2) + '-' + ('0' + parseInt(m[1], 10)).slice(-2);
  }

  function parseInvoice(text) {
    var raw = String(text || '').split(/\r?\n/).map(function (l) { return l.trim(); }).filter(Boolean);
    var lines = mergeInvoiceRows(raw);
    var flat = lines.join(' \n ');
    var inv = { supplier: '', date: '', number: '', cuit: '', total: 0, lines: [] };
    var m;
    if ((m = flat.match(/(?:C\.?\s?U\.?\s?I\.?\s?T\.?|CUIT)\D{0,8}(\d{2}\s?-?\s?\d{8}\s?-?\s?\d)/i))) inv.cuit = m[1].replace(/\s/g, '');
    /* la fecha se busca al lado de la palabra "fecha": si no, se colaba
       el "Inicio de actividades" o el vencimiento del CAE */
    var md = flat.match(/fecha\D{0,12}(\d{1,2}[/\-.]\d{1,2}[/\-.]\d{2,4})/i);
    if (md) inv.date = invISO(md[1]);
    else if ((m = flat.match(/\b(\d{1,2}[/\-.]\d{1,2}[/\-.]\d{2,4})\b/))) inv.date = invISO(m[1]);
    if ((m = flat.match(/(?:factura|comprobante|ticket|recibo|remito|n[°o.]?\s*)\s*[:\-]?\s*((?:[A-Za-z]\s*)?\d{3,5}\s*-\s*\d{4,8})/i))) inv.number = m[1].replace(/\s/g, '');
    /* el total: se busca al principio de la línea para no confundirlo con el SUBTOTAL */
    var tot = 0;
    lines.forEach(function (l) {
      var mm = l.match(/^\s*(?:importe\s+)?total\b[^0-9]{0,30}([0-9][0-9.,]{1,})\s*$/i);
      if (mm) tot = parseNumLoose(mm[1]);
    });
    if (!tot && (m = flat.match(/total\s*(?:general|a\s*pagar|factura)\D{0,25}([0-9][0-9.,]{2,})/i)))
      tot = parseNumLoose(m[1]);
    inv.total = tot;
    inv.lines = detectInvoiceItems(lines);
    /* proveedor: primera línea con letras que no sea un número ni un título genérico */
    for (var i = 0; i < Math.min(lines.length, 12); i++) {
      var l = lines[i];
      if (!/[a-zA-Z]{3}/.test(l)) continue;
      if (/^(factura|recibo|ticket|comprobante|documento|no valido|original|duplicado|fecha|cuit|senor|sres)/i.test(l)) continue;
      inv.supplier = l.replace(/\s{2,}.*$/, '').slice(0, 60);
      break;
    }
    return inv;
  }

  /* ---------- 4) previsualización y aplicación ---------- */
  function marginFor(category) {
    var v = (settings().categoryMargins || {})[category];
    return v === undefined ? 30 : num(v);
  }
  /** Precio de venta sugerido: mantiene el margen actual del producto. */
  function suggestedPrice(product, newCost) {
    if (!product) return roundPrice(newCost * (1 + marginFor('') / 100));
    var price = num(product.price), cost = num(product.cost);
    var ratio = (price > 0 && cost > 0) ? (price - cost) / price : -1;
    if (ratio > 0.02 && ratio < 0.95) return roundPrice(newCost / (1 - ratio));
    var m = marginFor(product.category);
    return roundPrice(newCost * (1 + m / 100));
  }
  function roundPrice(n) { return Math.round(num(n) * 100) / 100; }

  function processInvoiceText(text, fileName) {
    var b = biz(); if (!b) return;
    var parsed = parseInvoice(text);
    if (!parsed.lines.length) {
      invError('Se leyó el archivo pero no se reconocieron renglones de productos. Revisá el texto y usá "Pegar texto" para corregirlo.');
      return;
    }
    var sup = suppliers().filter(function (s) {
      return similarity(parsed.supplier, s.name) >= 0.6 || (parsed.cuit && String(s.cuit || '').replace(/\D/g, '') === String(parsed.cuit).replace(/\D/g, ''));
    })[0];
    State.invoice = {
      file: fileName || '', raw: text, supplier: (sup ? sup.name : parsed.supplier) || 'Sin proveedor',
      date: parsed.date, number: parsed.number, cuit: parsed.cuit, totalDetected: parsed.total,
      mode: 'add', updatePrices: true, payCash: false, payMethod: 'EFECTIVO',
      lines: parsed.lines.map(function (l) {
        var p = matchInvoiceProduct(l.desc, l.barcode);
        var cat = p ? p.category : (autoCategory(l.desc) || 'Sin categoría');
        return {
          desc: l.desc, barcode: l.barcode, qty: l.qty, cost: l.cost, product: p,
          include: true, isNew: !p, category: cat,
          priceBefore: p ? num(p.price) : 0, costBefore: p ? num(p.cost) : 0, stockBefore: p ? int(p.stock) : 0,
          newPrice: suggestedPrice(p, l.cost)
        };
      })
    };
    UI.hide('invProgress'); UI.hide('invDrop');
    UI.show('invPreview');
    renderInvoicePreview();
    UI.toast('Factura leída: ' + State.invoice.lines.length + ' renglones detectados', 'ok');
  }

  function pasteInvoiceText() {
    var t = ($('invTextArea').value || '');
    if (t.replace(/\s/g, '').length < 10) return UI.toast('Pegá el texto de la factura', 'warn');
    UI.hide('invManual');
    invProgress(70, 'Interpretando el texto…');
    setTimeout(function () { processInvoiceText(t, 'texto pegado'); }, 30);
  }

  function renderInvoicePreview() {
    var inv = State.invoice; if (!inv) return;
    invSyncControls();
    $('invSupplier').value = inv.supplier;
    $('invDate').value = inv.date || dayKey();
    $('invNumber').value = inv.number || '';
    var matched = inv.lines.filter(function (l) { return l.product; }).length;
    $('invSummary').innerHTML =
      '<span class="inv-chip blue">' + inv.lines.length + ' renglones</span>' +
      '<span class="inv-chip green">' + matched + ' coinciden con el catálogo</span>' +
      '<span class="inv-chip ' + (inv.lines.length - matched ? 'rose' : 'green') + '">' + (inv.lines.length - matched) + ' nuevos</span>' +
      (inv.cuit ? '<span class="inv-chip">CUIT ' + esc(inv.cuit) + '</span>' : '') +
      (inv.totalDetected ? '<span class="inv-chip amber">Total detectado ' + fmtMoney(inv.totalDetected) + '</span>' : '') +
      Object.keys(inv.lines.filter(function (l) { return l.include; }).reduce(function (m, l) {
        m[l.category || 'Sin categoría'] = (m[l.category || 'Sin categoría'] || 0) + 1; return m;
      }, {})).map(function (k) {
        return '<span class="inv-chip blue">' + esc(k) + '</span>';
      }).join('');

    var total = inv.lines.reduce(function (s, l) { return s + (l.include ? l.qty * l.cost : 0); }, 0);
    var dlc = $('invCatList');
    if (dlc) dlc.innerHTML = categories().map(function (c) { return '<option value="' + esc(c.name) + '"></option>'; }).join('');
    $('invTotalEst').textContent = fmtMoney(total);
    $('invPayCash').checked = inv.payCash;
    $('invPayMethod').value = inv.payMethod;

    $('invLines').innerHTML = inv.lines.map(function (l, i) {
      var stockNew = l.product ? (inv.mode === 'replace' ? l.qty : l.stockBefore + l.qty) : l.qty;
      return '<tr class="inv-tr' + (l.include ? '' : ' off') + '">' +
        '<td><input type="checkbox" ' + (l.include ? 'checked' : '') + ' onchange="toggleInvoiceLine(' + i + ',this.checked)" /></td>' +
        '<td><div class="inv-desc">' + esc(l.desc) + '</div>' +
          (l.barcode ? '<div class="text-[11px] text-slate-400 font-mono">' + esc(l.barcode) + '</div>' : '') + '</td>' +
        '<td><select class="inv-sel" onchange="setInvoiceLineProduct(' + i + ',this.value)">' +
            '<option value="">— Crear nuevo —</option>' +
            products().map(function (p) {
              return '<option value="' + esc(p.id) + '"' + (l.product && l.product.id === p.id ? ' selected' : '') + '>' + esc(p.name) + '</option>';
            }).join('') +
          '</select></td>' +
        '<td>' + (l.product
            ? '<span class="inv-chip">' + esc(l.product.category) + '</span>'
            : '<input class="inv-cat" list="invCatList" value="' + esc(l.category) + '" onchange="setInvoiceLineCategory(' + i + ',this.value)" placeholder="Categoría" />') + '</td>' +
        '<td><input type="number" min="0" class="inv-num" value="' + l.qty + '" onchange="setInvoiceLineQty(' + i + ',this.value)" /></td>' +
        '<td><input type="number" min="0" class="inv-num" style="width:5.5rem" value="' + l.cost + '" onchange="setInvoiceLineCost(' + i + ',this.value)" /></td>' +
        '<td class="font-mono text-xs ' + (l.product ? '' : 'text-slate-300') + '">' + (l.product ? fmtMoney(l.costBefore) : '—') + '</td>' +
        '<td class="inv-delta ' + (l.product ? 'up' : 'same') + '">' + fmtMoney(l.cost) + '</td>' +
        '<td class="font-mono text-xs ' + (l.product ? '' : 'text-slate-300') + '">' + (l.product ? fmtMoney(l.priceBefore) : '—') + '</td>' +
        '<td class="inv-delta ' + (l.product && inv.updatePrices && Math.abs(l.newPrice - l.priceBefore) > 0.01 ? 'up' : 'same') + '">' + fmtMoney(l.product && inv.updatePrices ? l.newPrice : (l.product ? l.priceBefore : suggestedPrice(null, l.cost))) + '</td>' +
        '<td class="inv-stock">' + (l.product ? l.stockBefore : '0') + ' <span class="arrow">→</span> <b>' + stockNew + '</b></td>' +
      '</tr>';
    }).join('');
  }
  function toggleInvoiceLine(i, on) { if (State.invoice && State.invoice.lines[i]) { State.invoice.lines[i].include = !!on; renderInvoicePreview(); } }
  function setInvoiceLineQty(i, v) { var l = State.invoice.lines[i]; if (!l) return; l.qty = Math.max(0, int(v)); renderInvoicePreview(); }
  function setInvoiceLineCost(i, v) {
    var l = State.invoice.lines[i]; if (!l) return;
    l.cost = Math.max(0, num(v));
    l.newPrice = suggestedPrice(l.product, l.cost);
    renderInvoicePreview();
  }
  function setInvoiceLineProduct(i, id) {
    var l = State.invoice.lines[i]; if (!l) return;
    var p = id ? productById(id) : null;
    l.product = p; l.isNew = !p;
    if (p) { l.costBefore = num(p.cost); l.priceBefore = num(p.price); l.stockBefore = int(p.stock); }
    l.newPrice = suggestedPrice(p, l.cost);
    renderInvoicePreview();
  }
  function setInvoiceLineCategory(i, name) {
    var l = State.invoice && State.invoice.lines[i];
    if (!l) return;
    l.category = String(name || '').trim() || 'Sin categoría';
    renderInvoicePreview();
  }
  function setInvoiceMode(m) { if (State.invoice) { State.invoice.mode = m; renderInvoicePreview(); } }

  /** Renovar el soporte mensual exclusivo (lo hace el super administrador). */
  function licRenovar(negocioId, meses) {
    var b = State.businesses.filter(function (x) { return x.id === negocioId; })[0];
    if (!b) return;
    b.licencia = b.licencia || {};
    var base = licDias() > 0 && b.licencia.vence ? parseDate(b.licencia.vence) : new Date();
    if (!base || isNaN(base.getTime())) base = new Date();
    base.setMonth(base.getMonth() + int(meses, 1));
    b.licencia.vence = dayKey(base);
    b.licencia.estado = 'activa';
    b.licencia.fuente = 'local';
    DB.save();
    UI.toast('Soporte mensual exclusivo renovado hasta ' + b.licencia.vence, 'ok');
    if (typeof renderAdminLicencias === 'function') renderAdminLicencias();
    licRender();
  }
  function licSuspender(negocioId) {
    var b = State.businesses.filter(function (x) { return x.id === negocioId; })[0];
    if (!b) return;
    b.licencia = b.licencia || {};
    b.licencia.estado = b.licencia.estado === 'suspendida' ? 'activa' : 'suspendida';
    DB.save();
    UI.toast(b.licencia.estado === 'suspendida' ? 'Negocio suspendido' : 'Negocio reactivado', 'ok');

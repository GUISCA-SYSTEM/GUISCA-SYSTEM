  /* ---- Banderas de la plataforma: las maneja el super admin ---- */
  function platformFlags() {
    var f = Store.get('mn_platform', null);
    if (!f || typeof f !== 'object') f = {};
    if (f.employees === undefined) f.employees = true;
    return f;
  }
  function setPlatformFlag(key, value) {
    var f = platformFlags();
    f[key] = !!value;
    Store.set('mn_platform', f);
    if (typeof Realtime !== 'undefined' && Realtime && Realtime.push) Realtime.push('flags');
    return f;
  }
  /** ¿El administrador habilitó el módulo de empleados en la plataforma? */
  function employeesModuleOn() { return platformFlags().employees === true; }
  /** ¿Está autorizado el módulo para el negocio activo? (plataforma + negocio) */
  function employeesEnabled() {
    var b = biz();
    if (!b || !employeesModuleOn()) return false;
    return b.employeesEnabled !== false;
  }
  function employeesList() { var b = biz(); if (!b) return []; b.employees = b.employees || []; return b.employees; }
  function employeeById(id) {
    var l = employeesList();
    for (var i = 0; i < l.length; i++) if (l[i].id === id) return l[i];
    return null;
  }
  /* Rol personalizado: el dueño marca una por una las secciones habilitadas.
     No es un rol mas de la lista: se guarda en el empleado (campo "views"). */
  var CUSTOM_ROLE = { id: 'PERSONALIZADO', name: 'Personalizado', icon: '🎚️',
    desc: 'Elegís una por una las secciones que puede ver' };
  /* Secciones que se le pueden dar a un empleado. Empleados y Configuracion
     quedan siempre reservados al dueño (ver canAccess). Los nombres y las
     descripciones son los mismos que usa el menú, para que no se confundan. */
  var EMPLOYEE_VIEWS = [
    { id: 'dashboard',  name: 'Dashboard',     icon: '📊', desc: 'Resumen del día' },
    { id: 'sales',      name: 'Ventas',        icon: '🧾', desc: 'Caja y tickets' },
    { id: 'products',   name: 'Productos',     icon: '📦', desc: 'Catálogo y precios' },
    { id: 'categories', name: 'Categorías',    icon: '🏷️', desc: 'Rubros y márgenes' },

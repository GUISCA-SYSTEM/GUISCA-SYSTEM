  /* =========================================================
     15 · LICENCIAS, PLANES Y CONTROL DE ACCESO
     ---------------------------------------------------------
     Cada negocio tiene una licencia con clave, plan y fecha
     de vencimiento. Si el soporte mensual exclusivo vence, la app entra en
     MODO LIMITADO: se puede consultar todo, pero no registrar
     ventas, compras ni ajustes de stock hasta renovar.
     La verificación es contra tu servidor; si no hay conexión
     se usa el último resultado conocido (gracia offline).
     ========================================================= */

  /** Genera una clave legible: MNPRO-7F3K-9Q2M */
  function licClave() {
    var abc = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
    var bloque = function () {
      var s = '';
      for (var i = 0; i < 4; i++) s += abc.charAt(Math.floor(Math.random() * abc.length));
      return s;
    };
    return 'MNPRO-' + bloque() + '-' + bloque();
  }
  function licEndpoint() {
    var f = platformFlags();
    return (f && f.licenciaEndpoint) || '';
  }
  /** Crea o completa la licencia del negocio activo (nunca bloquea la demo). */
  function ensureLicencia() {
    var b = biz(); if (!b) return null;
    if (!b.licencia) {
      b.licencia = {
        clave: licClave(),
        plan: bizPlanKey(),
        estado: 'activa',                 // activa | prueba | suspendida
        vence: licSumarDias(365),
        graciaDias: 7,
        ultimaVerificacion: '',
        fuente: 'local'
      };
    }
    if (!b.licencia.clave) b.licencia.clave = licClave();
    if (!b.licencia.vence) b.licencia.vence = licSumarDias(365);
    if (b.licencia.graciaDias === undefined) b.licencia.graciaDias = 7;
    if (!b.licencia.estado) b.licencia.estado = 'activa';
    return b.licencia;
  }
  function licSumarDias(dias) {
    var d = new Date(); d.setDate(d.getDate() + dias);
    return dayKey(d);
  }
  /** Días hasta el vencimiento (negativo = ya venció). */
  function licDias() {
    var L = ensureLicencia(); if (!L || !L.vence) return 9999;
    var hoy = new Date(); hoy.setHours(0, 0, 0, 0);
    var fin = parseDate(L.vence);
    if (!fin) return 9999;
    fin = new Date(fin.getFullYear(), fin.getMonth(), fin.getDate());
    return Math.round((fin - hoy) / 86400000);
  }
  /** activa | prueba | gracia | vencida | suspendida */
  function licEstado() {
    var L = ensureLicencia(); if (!L) return 'vencida';
    if (L.estado === 'suspendida') return 'suspendida';
    var d = licDias();
    if (d < 0) return (d < -num(L.graciaDias, 7)) ? 'vencida' : 'gracia';
    return L.estado === 'prueba' ? 'prueba' : 'activa';
  }
  function licOk() {
    var e = licEstado();
    return e === 'activa' || e === 'prueba' || e === 'gracia';
  }
  function licTexto() {
    var e = licEstado(), d = licDias();
    if (e === 'suspendida') return 'Licencia suspendida';
    if (e === 'vencida') return 'Soporte mensual exclusivo vencido';
    if (e === 'gracia') return 'Soporte mensual exclusivo vencido · ' + Math.abs(d) + ' día(s) de gracia';
    if (e === 'prueba') return 'Período de prueba · ' + d + ' día(s)';
    return d <= 15 ? 'Activa · vence en ' + d + ' día(s)' : 'Activa';
  }

}
.pdf-btn:hover { background: #eff6ff; border-color: #bfdbfe; transform: translateY(-1px); }
.pdf-btn:active { transform: scale(.94); }

/* ---------- 15 · LECTOR DE FACTURAS DE PROVEEDORES ---------- */
.inv-drop {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  gap: .15rem; padding: 2rem 1rem; text-align: center; cursor: pointer;

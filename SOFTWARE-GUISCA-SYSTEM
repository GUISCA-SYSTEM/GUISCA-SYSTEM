  /** Importa un respaldo: reemplaza los datos de ESTE dispositivo por los del
      archivo. Acepta el formato nuevo y los respaldos viejos (array pelado). */
  function importAll(input) {
    var file = input && input.files && input.files[0];
    if (!file) return;
    var fr = new FileReader();
    fr.onerror = function () { UI.toast('No se pudo abrir el archivo', 'error'); };
    fr.onload = function () {
      safe(function () {
        var data;
        try { data = JSON.parse(fr.result); }
        catch (e) { return UI.toast('El archivo no es un respaldo válido', 'error', 6000); }
        var paquete = Array.isArray(data) ? { negocios: data } : (data || {});
        var negocios = paquete.negocios || paquete.businesses;
        if (!Array.isArray(negocios) || !negocios.length) {
          return UI.toast('El respaldo no tiene negocios para importar', 'error', 6000);
        }
        var sa = paquete.superadmin || paquete.superAdmin || null;
        var plat = paquete.plataforma || paquete.platform || null;
        var nEmp = 0;
        negocios.forEach(function (b) { nEmp += (b.employees || []).length; });
        var msg = 'Se van a reemplazar los datos de ESTE dispositivo por los del respaldo:\n\n' +
          '· ' + negocios.length + ' negocio(s)\n' +
          '· ' + nEmp + ' empleado(s)\n' +
          (sa && sa.hash ? '· acceso de administrador\n' : '') +
          '\nDespués de importar, las mismas credenciales funcionan acá.\n¿Continuar?';
        if (!UI.confirm(msg)) return;
        State.businesses = negocios;
        DB.save();
        if (sa && sa.email && sa.hash) Store.set(SuperAdmin.KEY, sa);
        if (plat && typeof plat === 'object') Store.set('mn_platform', plat);
        if (negocios[0] && negocios[0].id) Store.set('mn_current_business', negocios[0].id);
        Store.del('mn_current_user');
        UI.toast('Respaldo importado. Reiniciando…', 'ok', 4000);
        setTimeout(function () { try { location.reload(); } catch (e) {} }, 1200);
      }, 'importar respaldo');
    };
    fr.readAsText(file);
  }

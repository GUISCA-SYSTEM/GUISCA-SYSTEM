  /** Palabras normalizadas de un texto ("COCA COLA 1.5L" → coca, cola, 15l). */
  function normWords(s) {
    return String(s || '').toLowerCase().split(/[^a-z0-9]+/).map(function (w) {
      return stripAccents(w).replace(/[^a-z0-9]/g, '');
    }).filter(function (w) { return w.length >= 2; });
  }

  /** Deduce la categoría de un producto a partir de su descripción. */
  function autoCategory(desc) {
    var words = normWords(desc), n = normName(desc);
    if (!words.length) return '';
    var cats = categories(), i, c;
    /* 1) si el nombre de una categoría propia aparece como palabra */
    for (i = 0; i < cats.length; i++) {
      c = normName(cats[i].name);
      if (!c || c.length < 3) continue;
      if (c.indexOf(' ') >= 0 ? n.indexOf(c) >= 0 : words.indexOf(c) >= 0) return cats[i].name;
    }
    /* 2) por palabras clave del rubro: una palabra clave simple tiene que ser
          una palabra entera (si no, "MARPLATA" contendría "lata" y sería bebida) */
    var best = '', hits = 0;
    for (var label in CAT_KEYWORDS) {
      if (!CAT_KEYWORDS.hasOwnProperty(label)) continue;
      var kws = CAT_KEYWORDS[label], k, cnt = 0;
      for (k = 0; k < kws.length; k++) {
        var kw = normName(kws[k]);
        if (!kw) continue;
        if (kw.indexOf(' ') >= 0 || words.indexOf(kw) >= 0) cnt++;
      }
      if (cnt > hits) { hits = cnt; best = label; }
    }
    if (!best) return '';
    /* 3) ¿ya existe una categoría con ese nombre en el negocio? */
    for (i = 0; i < cats.length; i++) if (normName(cats[i].name) === normName(best)) return cats[i].name;
    return best;
  }

  /** Devuelve la categoría; si no existe en el negocio, la crea. */
  function ensureCategory(name) {
    var b = biz(); if (!b) return 'Sin categoría';
    var want = String(name || '').trim() || 'Sin categoría';
    var list = categories();
    for (var i = 0; i < list.length; i++) {
      if (normName(list[i].name) === normName(want)) return list[i].name;
    }
    b.categories = b.categories || [];
    b.categories.push({ id: uid('c'), name: want, color: categoryColor(want, b.categories.length) });
    return want;
  }


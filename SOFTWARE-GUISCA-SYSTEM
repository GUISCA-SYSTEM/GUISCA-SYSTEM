  /* ---- 14.2 Contexto: números ya calculados por el sistema ---- */
  function aiSalesIn(from, to) {
    return sales().filter(function (s) { var d = parseDate(s.date); return d && d >= from && d <= to; });
  }
  function aiPeriod(days) {
    var to = new Date(); to.setHours(23, 59, 59, 999);
    var from = new Date(); from.setDate(from.getDate() - (days - 1)); from.setHours(0, 0, 0, 0);
    return summarize(aiSalesIn(from, to));
  }
  function aiMonth(offset) {
    var now = new Date(), y = now.getFullYear(), m = now.getMonth() + (offset || 0);
    var from = new Date(y, m, 1, 0, 0, 0, 0);
    var to = new Date(y, m + 1, 0, 23, 59, 59, 999);
    return summarize(aiSalesIn(from, to));
  }
  function aiCash(days) {
    var from = new Date(); from.setDate(from.getDate() - (days - 1)); from.setHours(0, 0, 0, 0);
    var ing = 0, egr = 0;
    cashList().forEach(function (m) {
      var d = parseDate(m.date); if (!d || d < from) return;
      var t = String(m.type || '').toUpperCase(), a = num(m.amount);
      if (t === 'GASTO' || t === 'RETIRO' || t === 'EGRESO' || t === 'SALIDA') egr += a; else ing += a;
    });
    return { ingresos: ing, egresos: egr, saldo: ing - egr };
  }
  /** Contexto compacto de UN negocio (aislamiento por businessId). */
  function aiBuildContext() {

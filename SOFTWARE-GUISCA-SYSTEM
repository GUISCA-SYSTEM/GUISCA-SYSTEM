  var superSession = false;   // solo en memoria: se pierde al recargar o cerrar sesión
  var Auth = {
    canStrong: function () { return !!(window.crypto && window.crypto.subtle && window.TextEncoder); },
    enc: function (t) { return new TextEncoder().encode(String(t)); },
    hex: function (buf) {
      var a = new Uint8Array(buf), t = '';
      for (var i = 0; i < a.length; i++) t += ('0' + a[i].toString(16)).slice(-2);
      return t;
    },
    rand: function (n) { var a = new Uint8Array(n); (window.crypto || window.msCrypto).getRandomValues(a); return a; },
    derive: function (pass, salt, algo) {
      if (algo === 'pbkdf2') {
        if (!Auth.canStrong()) return Promise.reject(new Error('sin WebCrypto'));
        return crypto.subtle.importKey('raw', Auth.enc(pass), 'PBKDF2', false, ['deriveBits']).then(function (key) {
          return crypto.subtle.deriveBits({ name: 'PBKDF2', salt: Auth.enc(salt), iterations: 120000, hash: 'SHA-256' }, key, 256);
        }).then(Auth.hex);
      }
      var h = 2166136261, t = salt + '|' + pass, out = '';   // respaldo para navegadores sin WebCrypto
      for (var r = 0; r < 4; r++) {
        for (var i = 0; i < t.length; i++) { h ^= t.charCodeAt(i); h = Math.imul(h, 16777619) >>> 0; }
        out += ('00000000' + h.toString(16)).slice(-8);

.bn-item.active::before { content: ''; position: absolute; top: 0; left: 18%; right: 18%; height: 3px; border-radius: 99px; background: var(--nv-color, #2563eb); box-shadow: 0 0 10px var(--nv-color, #2563eb); }

/* ---------- 06 · TABLAS, TAGS Y BADGES ---------- */
/* Tables */
.table-wrap { overflow-x: auto; border: 1px solid var(--border); border-radius: 12px; }
.table { width: 100%; border-collapse: collapse; font-size: .88rem; }
.table thead th { text-align: left; padding: .65rem .8rem; font-weight: 600; color: #475569; background: #f8fafc; border-bottom: 1.5px solid #e2e8f0; white-space: nowrap; }
.table tbody td { padding: .7rem .8rem; border-bottom: 1px solid #f1f5f9; vertical-align: middle; }
.table tbody tr:hover { background: #f8fafc; }
.table tbody tr:last-child td { border-bottom: none; }

/* Tags / badges */
.tag { display: inline-flex; align-items: center; gap: .25rem; padding: .2rem .55rem; border-radius: 9999px; font-size: .78rem; font-weight: 600; }
.tag-green { background: #ecfdf5; color: #065f46; }
.tag-amber { background: #fffbeb; color: #92400e; }
.tag-red { background: #fef2f2; color: #991b1b; }
.tag-rose { background: #fff1f2; color: #9f1239; }
.tag-blue { background: #eff6ff; color: #1e3a8a; }

/* ---------- 07 · GRÁFICOS Y WIZARD ---------- */
/* Charts inline */
.chart-bar { display: flex; align-items: flex-end; gap: .35rem; height: 120px; }
.chart-bar .col { flex: 1; background: linear-gradient(180deg, #93c5fd, #2563eb); border-radius: 6px 6px 2px 2px; min-width: 22px; position: relative; transition: height .4s ease; }
.chart-bar .col::after { content: attr(data-label); position: absolute; bottom: -18px; left: 50%; transform: translateX(-50%); font-size: 10px; color: #64748b; white-space: nowrap; }

/* Wizard steps */
.step-indicator { width: 36px; height: 36px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-weight: 800; font-size: .85rem; flex-shrink: 0; }
.step-indicator.active { background: var(--primary); color: #fff; box-shadow: 0 0 0 4px rgba(37,99,235,.15); }
.step-indicator.done { background: var(--success); color: #fff; }
.step-indicator.pending { background: #e2e8f0; color: #94a3b8; }
.industry-card.selected { border-color: var(--primary) !important; background: var(--primary-soft); box-shadow: 0 0 0 3px rgba(37,99,235,.12); }
.industry-card.hidden-card { display: none; }

/* ---------- 08 · COMPONENTES DE COLOR ---------- */
/* ============ COMPONENTES DE COLOR ============ */
.btn-violet { background: linear-gradient(135deg, #8b5cf6, #6d28d9); color: #fff; box-shadow: 0 4px 14px rgba(124,58,237,.25); }
.btn-violet:hover { background: linear-gradient(135deg, #7c3aed, #5b21b6); box-shadow: 0 6px 20px rgba(124,58,237,.35); transform: translateY(-1px); }
.btn-emerald { background: linear-gradient(135deg, #10b981, #059669); color: #fff; box-shadow: 0 4px 14px rgba(16,185,129,.25); }
.btn-emerald:hover { background: linear-gradient(135deg, #059669, #047857); box-shadow: 0 6px 20px rgba(16,185,129,.35); transform: translateY(-1px); }
.btn-amber { background: linear-gradient(135deg, #f59e0b, #d97706); color: #fff; box-shadow: 0 4px 14px rgba(245,158,11,.25); }
.btn-amber:hover { background: linear-gradient(135deg, #d97706, #b45309); box-shadow: 0 6px 20px rgba(245,158,11,.35); transform: translateY(-1px); }
.btn-rose { background: linear-gradient(135deg, #fb7185, #e11d48); color: #fff; box-shadow: 0 4px 14px rgba(225,29,72,.25); }
.btn-rose:hover { background: linear-gradient(135deg, #e11d48, #be123c); box-shadow: 0 6px 20px rgba(225,29,72,.35); transform: translateY(-1px); }

.tag-violet { background: #f5f3ff; color: #5b21b6; }
.tag-cyan { background: #ecfeff; color: #155e75; }
.tag-orange { background: #fff7ed; color: #9a3412; }
.tag-indigo { background: #eef2ff; color: #3730a3; }
.tag-teal { background: #f0fdfa; color: #115e59; }

/* Tarjeta KPI */
.kpi { position: relative; overflow: hidden; background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 1rem 1.1rem; box-shadow: var(--shadow); transition: transform .18s ease, box-shadow .18s ease; }
.kpi::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 4px; background: var(--kpi, #2563eb); }
.kpi::after { content: ''; position: absolute; right: -30px; top: -30px; width: 110px; height: 110px; border-radius: 50%; background: var(--kpi-soft, #eff6ff); opacity: .8; z-index: 0; }
.kpi > * { position: relative; z-index: 1; }
.kpi:hover { transform: translateY(-3px); box-shadow: var(--shadow-lg); }
.kpi-click { cursor: pointer; }
.kpi-click:hover { border-color: var(--kpi, #2563eb); }
.kpi-click:focus-visible { outline: 2px solid var(--kpi, #2563eb); outline-offset: 2px; }
.insight { position: relative; }
  .ai-code { background: #0f172a; color: #e2e8f0; font-size: .68rem; line-height: 1.5; padding: 1rem;
    border-radius: 12px; overflow: auto; max-height: 46vh; white-space: pre; }
  .insight-explain { position: absolute; top: .45rem; right: .5rem; font-size: .62rem; font-weight: 900;
    letter-spacing: .04em; padding: .18rem .45rem; border-radius: 999px; background: #fff;
    border: 1px solid #e2e8f0; color: #475569; opacity: .75; }
  .insight-explain:hover { opacity: 1; border-color: #a78bfa; color: #6d28d9; background: #f5f3ff; }
  .kpi-more { margin-top: .5rem; font-size: .6rem; font-weight: 900; letter-spacing: .06em; text-transform: uppercase; color: var(--kpi, #2563eb); opacity: .7; }
.kpi-click:hover .kpi-more { opacity: 1; }
.ai-chat { display: flex; flex-direction: column; gap: .75rem; min-height: 300px; max-height: 52vh;
    overflow-y: auto; padding: .25rem; }

  /** Junta todo lo que necesitan los detalles: ventas, totales, por producto y por día. */
  function reportDetailData() {
    var r = reportRange(State.reportPeriod);
    var list = sales().filter(function (s) { return inRange(s.date, r); });
    var sum = summarize(list);
    var byP = {};
    list.forEach(function (s) {
      (s.items || []).forEach(function (it) {
        var p = productById(it.productId);
        var id = it.productId || ('x' + (p ? p.id : 'eliminado'));
        if (!byP[id]) {
          byP[id] = { name: p ? p.name : 'Producto eliminado', cat: p ? (p.category || '—') : '—',
            costNow: p ? num(p.cost) : 0, priceNow: p ? num(p.price) : 0, qty: 0, rev: 0, cost: 0 };
        }
        var q = int(it.qty);
        byP[id].qty += q;
        byP[id].rev += q * num(it.price);
        byP[id].cost += q * num(p && p.cost);
      });
    });
    var prods = Object.keys(byP).map(function (k) { return byP[k]; });
    var byD = {};
    list.forEach(function (s) {
      var k = dayKey(s.date);
      if (!byD[k]) byD[k] = { day: k, tickets: 0, units: 0, revenue: 0 };
      byD[k].tickets++;
      byD[k].units += (s.items || []).reduce(function (a, i) { return a + int(i.qty); }, 0);
      byD[k].revenue += num(s.total);
    });
    var days = Object.keys(byD).map(function (k) { return byD[k]; })
      .sort(function (a, c) { return String(a.day).localeCompare(String(c.day)); });
    return { r: r, list: list, sum: sum, prods: prods, days: days, label: reportRangeLabel() };
  }


.bar-row .bar-val { font-size: .8rem; font-weight: 800; color: #0f172a; font-variant-numeric: tabular-nums; white-space: nowrap; }

/* Gráfico de columnas verticales multicolor */
.vbars { display: flex; align-items: flex-end; gap: .4rem; height: 170px; padding-top: .5rem; }

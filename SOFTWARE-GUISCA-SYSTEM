  /* =========================================================
     16 · PDF — generador propio (sin librerías ni CDN)
     =====================================================================
     Arma un PDF válido (A4, fuentes Helvetica, texto y tablas) y lo
     devuelve como Blob listo para descargar. Todo se calcula en el
     navegador: no depende de internet.
     ===================================================================== */
  var HELV_W = [278,278,355,556,556,889,667,191,333,333,389,584,278,333,278,278,
    556,556,556,556,556,556,556,556,556,556,278,278,584,584,584,556,
    1015,667,667,722,722,667,611,778,722,278,500,667,556,833,722,778,
    667,778,722,667,611,722,667,944,667,667,611,278,278,278,469,556,
    333,556,556,500,556,556,278,556,556,222,222,500,222,833,556,556,
    556,556,333,500,278,556,500,722,500,500,500,334,260,334,584];
  var PDF_H = 841.89, PDF_W = 595.28;
  var C_INK = [30, 41, 59], C_MUTED = [100, 116, 139], C_LINE = [226, 232, 240];

  /** Convierte a WinAnsi (Latin-1 práctico) para que el PDF sea portable. */
  function pdfWinAnsi(s) {
    var map = { '\u2013': 150, '\u2014': 151, '\u2018': 145, '\u2019': 146, '\u201c': 147, '\u201d': 148, '\u2022': 149, '\u20ac': 128, '\u2026': 133, '\u00b7': 183 };
    var out = '';
    for (var i = 0; i < s.length; i++) {
      var c = s.charAt(i), code = s.charCodeAt(i);
      if (map[c] !== undefined) out += String.fromCharCode(map[c]);
      else if (code === 10 || code === 13 || code < 256) out += c;
      else out += '?';
    }
    return out;
  }
  function pdfStr(s) {
    return '(' + pdfWinAnsi(String(s)).replace(/\\/g, '\\\\').replace(/\(/g, '\\(').replace(/\)/g, '\\)').replace(/[\r\n]/g, ' ') + ')';
  }
  function pdfRgb(c) { return (c[0] / 255).toFixed(3) + ' ' + (c[1] / 255).toFixed(3) + ' ' + (c[2] / 255).toFixed(3); }
  function pdfWidth(s, size) {
    var w = 0;
    for (var i = 0; i < s.length; i++) {
      var code = s.charCodeAt(i);
      w += (code >= 32 && code <= 126) ? HELV_W[code - 32] : 556;
    }
    return w * (size || 9) / 1000;
  }
  function pdfCut(s, size, max) {
    s = String(s);
    if (pdfWidth(s, size) <= max) return s;
    while (s.length > 1 && pdfWidth(s + '...', size) > max) s = s.slice(0, -1);
    return s + '...';
  }

  function PdfPage() { this.ops = []; }
  PdfPage.prototype.txt = function (x, y, s, size, bold, color, align) {
    size = size || 9;
    var w = pdfWidth(s, size);
    var xx = align === 'r' ? x - w : (align === 'c' ? x - w / 2 : x);
    this.ops.push('BT /' + (bold ? 'F2' : 'F1') + ' ' + size + ' Tf ' + pdfRgb(color || C_INK) +
      ' rg 1 0 0 1 ' + xx.toFixed(2) + ' ' + (PDF_H - y).toFixed(2) + ' Tm ' + pdfStr(s) + ' Tj ET');
    return this;
  };
  PdfPage.prototype.rect = function (x, y, w, h, color) {
    this.ops.push(pdfRgb(color) + ' rg ' + x.toFixed(2) + ' ' + (PDF_H - y - h).toFixed(2) + ' ' +
      w.toFixed(2) + ' ' + h.toFixed(2) + ' re f');
    return this;
  };
  PdfPage.prototype.rule = function (x1, y1, x2, y2, color, width) {
    this.ops.push(pdfRgb(color || C_LINE) + ' RG ' + (width || 0.7).toFixed(2) + ' w ' +
      x1.toFixed(2) + ' ' + (PDF_H - y1).toFixed(2) + ' m ' + x2.toFixed(2) + ' ' + (PDF_H - y2).toFixed(2) + ' l S');
    return this;
  };

  function PdfDoc() { this.pages = [new PdfPage()]; this.y = 54; }
  PdfDoc.prototype.pg = function () { return this.pages[this.pages.length - 1]; };
  PdfDoc.prototype.need = function (h) {
    if (this.y + h > 792) { this.pages.push(new PdfPage()); this.y = 54; }
  };
  PdfDoc.prototype.head = function (title, subtitle) {
    var p = this.pg();
    p.rect(40, 40, 515, 34, [37, 99, 235]);
    p.txt(52, 63, title, 14, true, [255, 255, 255]);
    if (subtitle) p.txt(543, 61, subtitle, 8.5, false, [219, 234, 254], 'r');
    this.y = 96;
    return this;
  };
  PdfDoc.prototype.section = function (t) {
    this.need(34);
    var p = this.pg();
    p.txt(40, this.y, t, 10.5, true, [15, 23, 42]);
    p.rule(40, this.y + 5, 555, this.y + 5, [203, 213, 225]);
    this.y += 20;
    return this;
  };
  PdfDoc.prototype.note = function (t) {
    this.need(16);
    this.pg().txt(40, this.y, t, 8.5, false, C_MUTED);
    this.y += 14;
    return this;
  };
  PdfDoc.prototype.kv = function (rows) {
    var i, p, k, v, x;
    for (i = 0; i < rows.length; i++) {
      this.need(17);
      p = this.pg();
      if (i % 2 === 0) p.rect(40, this.y - 11, 515, 17, [248, 250, 252]);
      p.txt(46, this.y, pdfCut(rows[i][0], 9, 300), 9, false, C_INK);
      p.txt(549, this.y, pdfCut(String(rows[i][1]), 9, 190), 9, true, [15, 23, 42], 'r');
      this.y += 17;
    }
    this.y += 6;
    return this;
  };
  /** cols: [{label, w, align}] · rows: [[valor,…]] */
  PdfDoc.prototype.table = function (cols, rows, opt) {
    opt = opt || {};
    var i, j, p, cx, w, total = 0, headY;
    for (i = 0; i < cols.length; i++) total += cols[i].w;
    var scale = 515 / total;
    for (i = 0; i < rows.length; i++) {
      this.need(opt.rowH || 15);
      p = this.pg();
      headY = this.y;
      if (i % 2 === 1) p.rect(40, this.y - 10, 515, opt.rowH || 15, [248, 250, 252]);
      cx = 40;
      for (j = 0; j < cols.length; j++) {
        w = cols[j].w * scale;
        var val = rows[i][j] === undefined || rows[i][j] === null ? '' : String(rows[i][j]);
        var size = opt.size || 8.5;
        p.txt(cx + 4, this.y, pdfCut(val, size, w - 8), size, j === 0, C_INK, cols[j].align || 'l');
        cx += w;
      }
      p.rule(40, this.y + 4, 555, this.y + 4, [241, 245, 249], 0.4);
      this.y += (opt.rowH || 15);
    }
    if (!rows.length) { this.need(18); this.pg().txt(44, this.y, 'Sin datos para el período seleccionado.', 8.5, false, C_MUTED); this.y += 18; }
    this.y += 8;
    return this;
  };
  PdfDoc.prototype.heads = function (cols) {
    this.need(20);
    var p = this.pg(), total = 0, i, cx, w, scale;
    for (i = 0; i < cols.length; i++) total += cols[i].w;
    scale = 515 / total;
    p.rect(40, this.y - 10, 515, 18, [241, 245, 249]);
    cx = 40;
    for (i = 0; i < cols.length; i++) {
      w = cols[i].w * scale;
      p.txt(cx + 4, this.y, pdfCut(cols[i].label, 8, w - 8), 8, true, [51, 65, 85], cols[i].align || 'l');
      cx += w;
    }
    this.y += 18;
    return this;
  };
  PdfDoc.prototype.build = function (meta) {
    var i, objs = [], out = '%PDF-1.4\n', offsets = [], xref, count, bytes;
    for (i = 0; i < this.pages.length; i++) {
      this.pages[i].txt(40, 822, (meta && meta.business) || 'Mi Negocio Pro', 7.5, false, [148, 163, 184]);
      this.pages[i].txt(555, 822, 'Pagina ' + (i + 1) + ' de ' + this.pages.length, 7.5, false, [148, 163, 184], 'r');
      this.pages[i].rule(40, 815, 555, 815, [226, 232, 240], 0.5);
    }
    objs[1] = '<< /Type /Catalog /Pages 2 0 R >>';
    var kids = [];
    for (i = 0; i < this.pages.length; i++) kids.push((5 + i * 2) + ' 0 R');
    objs[2] = '<< /Type /Pages /Kids [' + kids.join(' ') + '] /Count ' + this.pages.length + ' >>';
    objs[3] = '<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica /Encoding /WinAnsiEncoding >>';
    objs[4] = '<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica-Bold /Encoding /WinAnsiEncoding >>';
    for (i = 0; i < this.pages.length; i++) {
      var pid = 5 + i * 2, cid = pid + 1;
      objs[pid] = '<< /Type /Page /Parent 2 0 R /MediaBox [0 0 595.28 841.89] ' +
        '/Resources << /Font << /F1 3 0 R /F2 4 0 R >> >> /Contents ' + cid + ' 0 R >>';
      var stream = this.pages[i].ops.join('\n');
      objs[cid] = '<< /Length ' + stream.length + ' >>\nstream\n' + stream + '\nendstream';
    }
    count = objs.length;
    for (i = 1; i < count; i++) {
      if (!objs[i]) continue;
      offsets[i] = out.length;
      out += i + ' 0 obj\n' + objs[i] + '\nendobj\n';
    }
    xref = out.length;
    out += 'xref\n0 ' + count + '\n0000000000 65535 f \n';
    for (i = 1; i < count; i++) out += String(offsets[i] || 0).padStart(10, '0') + ' 00000 n \n';
    out += 'trailer\n<< /Size ' + count + ' /Root 1 0 R >>\nstartxref\n' + xref + '\n%%EOF';
    bytes = new Uint8Array(out.length);
    for (i = 0; i < out.length; i++) bytes[i] = out.charCodeAt(i) & 0xFF;
    try { return new Blob([bytes], { type: 'application/pdf' }); }
    catch (e) { reportError(e, 'generar PDF'); return null; }
  };

  function downloadBlob(blob, name) {
    if (!blob) return false;
    try {
      var a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = name;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      setTimeout(function () { try { URL.revokeObjectURL(a.href); } catch (e) {} }, 4000);
      return true;
    } catch (e) { reportError(e, 'descargar archivo'); return false; }
  }


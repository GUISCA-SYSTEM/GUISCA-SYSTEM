  var REPORT_DETAILS = {
    revenue:   { title: 'Detalle de facturación', sub: 'Todas las operaciones del período', ico: '💵' },
    avgTicket: { title: 'Detalle del ticket promedio', sub: 'Operaciones ordenadas por monto', ico: '🧾' },
    units:     { title: 'Detalle de unidades vendidas', sub: 'Cuántas unidades de cada producto', ico: '📦' },
    gross:     { title: 'Detalle del margen bruto', sub: 'Cuánto queda por cada producto', ico: '💰' },
    cogs:      { title: 'Detalle del costo de mercadería', sub: 'Costo de lo vendido por producto', ico: '🏭' },
    perDay:    { title: 'Detalle de venta por día', sub: 'Facturación día por día', ico: '📅' },
    distinct:  { title: 'Detalle de productos vendidos', sub: 'Todos los productos que se vendieron', ico: '🧺' },
    avgMargin: { title: 'Detalle del margen promedio', sub: 'Margen de cada producto', ico: '📊' }
  };

  function reportRangeLabel() {
    return State.reportPeriod === 'today' ? 'Hoy' : State.reportPeriod === '7' ? 'Últimos 7 días' :
      State.reportPeriod === '365' ? 'Últimos 12 meses' : 'Últimos 30 días';
